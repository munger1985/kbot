    "metrics": "metrics",
    "logs": "logs",
    "dashboard": "dashboard",
    "host": "host",
}

PROFILE_SERVICES: dict[str, set[str]] = {
    "metrics": {"prometheus", "alertmanager"},
    "logs": {"loki", "alloy"},
    "dashboard": {"grafana"},
    "host": {"node-exporter"},
}

ROLE_SERVICES: dict[str, set[str]] = {
    "central": {"prometheus", "alertmanager", "loki", "grafana"},
    "collector": {
        "alloy",
        "node-exporter",
    },
}

DATABASE_SECTION = re.compile(
    r"^(?P<engine>oracle|mysql|postgres):(?P<target_key>[a-z0-9][a-z0-9_-]*)$"
)
PROMETHEUS_TARGET_SECTION = re.compile(
    r"^prometheus_target:(?P<target_key>[a-z0-9][a-z0-9_-]*)$"
)

