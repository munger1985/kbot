ARG PYTHON_IMAGE=python:3.12-slim-bookworm

FROM ${PYTHON_IMAGE} AS wheel-builder
USER root
ARG PIP_INDEX_URL=https://pypi.org/simple
ENV PIP_INDEX_URL=${PIP_INDEX_URL} \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1
WORKDIR /src
COPY packages/ packages/
COPY services/ services/
RUN python -m pip install --upgrade pip setuptools wheel && \
    mkdir -p /wheelhouse && \
    for project in packages/* services/*; do \
      if [ -f "$project/pyproject.toml" ]; then \
        python -m pip wheel --no-deps --wheel-dir /wheelhouse "$project"; \
      fi; \
    done

FROM ${PYTHON_IMAGE} AS runtime
USER root
ARG SERVICE_PACKAGES
ARG PIP_INDEX_URL=https://pypi.org/simple
ARG INSTALL_OS_PACKAGES=true
ARG INSTALL_CPU_TORCH=false
ARG TORCH_VERSION=2.11.0+cpu
ARG TORCHVISION_VERSION=0.26.0+cpu
ARG TORCH_INDEX_URL=https://download.pytorch.org/whl/cpu
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    HOME=/var/lib/kbot \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_INDEX_URL=${PIP_INDEX_URL} \
    KBOT_CONFIG_FILE=/etc/kbot/kbot.toml \
    KBOT_RESOURCE_DIR=/opt/kbot/resources
RUN if [ "$INSTALL_OS_PACKAGES" = "true" ]; then \
      apt-get update && \
      apt-get install -y --no-install-recommends \
        ca-certificates libgl1 libglib2.0-0 libmagic1 \
        tesseract-ocr tesseract-ocr-chi-sim tesseract-ocr-eng && \
      rm -rf /var/lib/apt/lists/*; \
    fi && \
    (getent group 10001 >/dev/null || groupadd --gid 10001 kbot) && \
    (getent passwd 10001 >/dev/null || \
      useradd --uid 10001 --gid 10001 --create-home kbot)
RUN if [ "$INSTALL_CPU_TORCH" = "true" ]; then \
      python -m pip install --index-url "$TORCH_INDEX_URL" \
        "torch==$TORCH_VERSION" "torchvision==$TORCHVISION_VERSION"; \
    fi
COPY --from=wheel-builder /wheelhouse /wheelhouse
RUN test -n "$SERVICE_PACKAGES" && \
    python -m pip install --find-links=/wheelhouse $SERVICE_PACKAGES && \
    rm -rf /wheelhouse
COPY resources/ /opt/kbot/resources/
COPY database/ /opt/kbot/database/
COPY scripts/db/ /opt/kbot/scripts/db/
COPY configuration/ /opt/kbot/configuration/
COPY installation/common/docker/python-entrypoint.sh /usr/local/bin/kbot-entrypoint
RUN chmod 0555 /usr/local/bin/kbot-entrypoint && \
    mkdir -p /var/lib/kbot /var/log/kbot /etc/kbot && \
    chown -R 10001:10001 /var/lib/kbot /var/log/kbot
WORKDIR /opt/kbot
ARG VERSION=dev
ARG REVISION=unknown
LABEL org.opencontainers.image.title="KBot 4.0" \
      org.opencontainers.image.version=${VERSION} \
      org.opencontainers.image.revision=${REVISION}
USER 10001:10001
ENTRYPOINT ["/usr/local/bin/kbot-entrypoint"]
CMD ["python", "-m", "main_api.entrypoints.api"]
