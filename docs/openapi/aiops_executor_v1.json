          },
          "parameter_values": {
            "$ref": "#/components/schemas/SqlPlanVerificationCheck"
          },
          "representativeness": {
            "default": "UNPROVEN",
            "enum": [
              "UNPROVEN",
              "NOT_APPLICABLE"
            ],
            "title": "Representativeness",
            "type": "string"
          },
          "resolved_objects": {
            "default": [],
            "items": {
              "$ref": "#/components/schemas/SqlPlanResolvedObject"
            },
            "maxItems": 128,
            "title": "Resolved Objects",
            "type": "array"
          },
          "schema_version": {
            "const": "SQL_PLAN_NATIVE_VERIFICATION.v1",
            "default": "SQL_PLAN_NATIVE_VERIFICATION.v1",
            "title": "Schema Version",
            "type": "string"
          },
          "unresolved_object_nodes": {
            "default": [],
            "items": {
              "maximum": 127.0,
              "minimum": 0.0,
              "type": "integer"
            },
            "maxItems": 128,
            "title": "Unresolved Object Nodes",
            "type": "array"
          }
        },
        "required": [
          "original_context",
          "parameter_types",
          "parameter_values",
          "limitations"
        ],
        "title": "SqlPlanNativeVerification",
        "type": "object"
      },
      "SqlPlanResolvedObject": {
        "additionalProperties": false,
        "properties": {
