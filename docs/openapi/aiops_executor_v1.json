{
  "components": {
    "schemas": {
      "DatabaseColumn": {
        "additionalProperties": false,
        "properties": {
          "logical_type": {
            "enum": [
              "STRING",
              "INTEGER",
              "DECIMAL",
              "BOOLEAN",
              "DATETIME",
              "NULL"
            ],
            "title": "Logical Type",
            "type": "string"
          },
          "name": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Name",
            "type": "string"
          },
          "sensitivity": {
            "enum": [
              "PUBLIC",
              "MASKED",
              "HASHED"
            ],
            "title": "Sensitivity",
            "type": "string"
          }
        },
        "required": [
          "name",
          "logical_type",
          "sensitivity"
        ],
        "title": "DatabaseColumn",
        "type": "object"
      },
      "DatabaseObservation": {
        "additionalProperties": false,
        "properties": {
          "capability_snapshot_hash": {
            "pattern": "^[0-9a-f]{64}$",
            "title": "Capability Snapshot Hash",
            "type": "string"
          },
          "captured_at": {
            "format": "date-time",
            "title": "Captured At",
            "type": "string"
          },
          "columns": {
            "items": {
              "$ref": "#/components/schemas/DatabaseColumn"
            },
            "title": "Columns",
            "type": "array"
          },
          "db_type": {
            "enum": [
              "POSTGRESQL",
              "ORACLE",
              "MYSQL"
            ],
            "title": "Db Type",
            "type": "string"
          },
          "db_version": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Db Version",
            "type": "string"
          },
          "duration_ms": {
            "minimum": 0.0,
            "title": "Duration Ms",
            "type": "integer"
          },
          "executor_request_id": {
            "format": "uuid",
            "title": "Executor Request Id",
            "type": "string"
          },
          "object_access": {
            "default": [],
            "items": {
              "$ref": "#/components/schemas/ObjectAccessObservation"
            },
            "maxItems": 1,
            "title": "Object Access",
            "type": "array"
          },
          "pagination": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/DiagnosticPaginationObservation"
              },
              {
                "type": "null"
              }
            ]
          },
          "parameters_sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "title": "Parameters Sha256",
            "type": "string"
          },
          "provenance": {
            "additionalProperties": true,
            "title": "Provenance",
            "type": "object"
          },
          "result_sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "title": "Result Sha256",
            "type": "string"
          },
          "row_count": {
            "minimum": 0.0,
            "title": "Row Count",
            "type": "integer"
          },
          "rows": {
            "items": {
              "items": {},
              "type": "array"
            },
            "title": "Rows",
            "type": "array"
          },
          "schema_version": {
            "const": "DATABASE_OBSERVATION.v1",
            "default": "DATABASE_OBSERVATION.v1",
            "title": "Schema Version",
            "type": "string"
          },
          "target_id": {
            "format": "uuid",
            "title": "Target Id",
            "type": "string"
          },
          "template_sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "title": "Template Sha256",
            "type": "string"
          },
          "tool_id": {
            "title": "Tool Id",
            "type": "string"
          },
          "tool_version": {
            "title": "Tool Version",
            "type": "string"
          },
          "truncated": {
            "title": "Truncated",
            "type": "boolean"
          },
          "variant": {
            "title": "Variant",
            "type": "string"
          },
          "warnings": {
            "default": [],
            "items": {
              "type": "string"
            },
            "title": "Warnings",
            "type": "array"
          }
        },
        "required": [
          "executor_request_id",
          "target_id",
          "tool_id",
          "tool_version",
          "variant",
          "template_sha256",
          "db_type",
          "db_version",
          "capability_snapshot_hash",
          "captured_at",
          "duration_ms",
          "columns",
          "rows",
          "row_count",
          "truncated",
          "result_sha256",
          "parameters_sha256"
        ],
        "title": "DatabaseObservation",
        "type": "object"
      },
      "DiagnosticPagination": {
        "additionalProperties": false,
        "description": "有界结果分批；数据库用同执行游标，来源用原生时间边界续取。",
        "properties": {
          "max_pages": {
            "maximum": 4.0,
            "minimum": 2.0,
            "title": "Max Pages",
            "type": "integer"
          },
          "page_size": {
            "maximum": 200.0,
            "minimum": 1.0,
            "title": "Page Size",
            "type": "integer"
          }
        },
        "required": [
          "page_size",
          "max_pages"
        ],
        "title": "DiagnosticPagination",
        "type": "object"
      },
      "DiagnosticPaginationObservation": {
        "additionalProperties": false,
        "description": "分批取回描述查询结果的读取范围，不声明源数据全量或历史窗口。",
        "properties": {
          "mode": {
            "const": "SINGLE_EXECUTION_CURSOR",
            "default": "SINGLE_EXECUTION_CURSOR",
            "title": "Mode",
            "type": "string"
          },
          "requested": {
            "$ref": "#/components/schemas/DiagnosticPagination"
          },
          "returned_page_rows": {
            "items": {
              "type": "integer"
            },
            "maxItems": 4,
            "title": "Returned Page Rows",
            "type": "array"
          },
          "source_completeness": {
            "const": "UNKNOWN",
            "default": "UNKNOWN",
            "title": "Source Completeness",
            "type": "string"
          },
          "stop_reason": {
            "enum": [
              "EXHAUSTED",
              "ROW_LIMIT",
              "BYTE_LIMIT",
              "CELL_LIMIT"
            ],
            "title": "Stop Reason",
            "type": "string"
          }
        },
        "required": [
          "requested",
          "returned_page_rows",
          "stop_reason"
        ],
        "title": "DiagnosticPaginationObservation",
        "type": "object"
      },
      "DynamicReadDiagnosticRequest": {
        "additionalProperties": false,
        "description": "动态 SQL 只在专用入口出现，不能混入固定目录请求。",
        "properties": {
          "executor_request_id": {
            "format": "uuid",
            "title": "Executor Request Id",
            "type": "string"
          },
          "grant": {
            "maxLength": 32768,
            "minLength": 64,
            "title": "Grant",
            "type": "string"
          },
          "idempotency_key": {
            "maxLength": 256,
            "minLength": 1,
            "title": "Idempotency Key",
            "type": "string"
          },
          "parameters": {
            "additionalProperties": true,
            "title": "Parameters",
            "type": "object"
          },
          "schema_version": {
            "const": "dynamic-diagnostic-execution-request.v1",
            "default": "dynamic-diagnostic-execution-request.v1",
            "title": "Schema Version",
            "type": "string"
          },
          "sql": {
            "maxLength": 100000,
            "minLength": 1,
            "title": "Sql",
            "type": "string"
          }
        },
        "required": [
          "executor_request_id",
          "grant",
          "sql",
          "parameters",
          "idempotency_key"
        ],
        "title": "DynamicReadDiagnosticRequest",
        "type": "object"
      },
      "ExecutionResultRef": {
        "additionalProperties": false,
        "properties": {
          "executor_request_id": {
            "format": "uuid",
            "title": "Executor Request Id",
            "type": "string"
          },
          "result_hash": {
            "anyOf": [
              {
                "pattern": "^[0-9a-f]{64}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Result Hash"
          },
          "result_ref": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ResourceRef"
              },
              {
                "type": "null"
              }
            ]
          },
          "schema_version": {
            "default": "aiops.executor.v1",
            "title": "Schema Version",
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/ExecutionStatus"
          }
        },
        "required": [
          "executor_request_id",
          "status"
        ],
        "title": "ExecutionResultRef",
        "type": "object"
      },
      "ExecutionStatus": {
        "enum": [
          "CREATED",
          "SUBMITTED",
          "RUNNING",
          "SUCCEEDED",
          "FAILED",
          "TIMED_OUT",
          "CANCELLED",
          "UNKNOWN"
        ],
        "title": "ExecutionStatus",
        "type": "string"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "MutationExecutionRequest": {
        "additionalProperties": false,
        "properties": {
          "execution_id": {
            "format": "uuid",
            "title": "Execution Id",
            "type": "string"
          },
          "executor_request_id": {
            "format": "uuid",
            "title": "Executor Request Id",
            "type": "string"
          },
          "idempotency_key": {
            "maxLength": 256,
            "minLength": 1,
            "title": "Idempotency Key",
            "type": "string"
          },
          "schema_version": {
            "default": "aiops.executor.v1",
            "title": "Schema Version",
            "type": "string"
          }
        },
        "required": [
          "execution_id",
          "executor_request_id",
          "idempotency_key"
        ],
        "title": "MutationExecutionRequest",
        "type": "object"
      },
      "ObjectAccessObservation": {
        "additionalProperties": false,
        "description": "零行 SELECT 的历史访问观察，不授予权限，也不证明业务行可见。",
        "properties": {
          "checked_at": {
            "format": "date-time",
            "title": "Checked At",
            "type": "string"
          },
          "db_type": {
            "enum": [
              "POSTGRESQL",
              "ORACLE",
              "MYSQL"
            ],
            "title": "Db Type",
            "type": "string"
          },
          "expires_at": {
            "format": "date-time",
            "title": "Expires At",
            "type": "string"
          },
          "grants_authority": {
            "const": false,
            "default": false,
            "title": "Grants Authority",
            "type": "boolean"
          },
          "object_ref": {
            "maxLength": 256,
            "minLength": 1,
            "title": "Object Ref",
            "type": "string"
          },
          "read_columns": {
            "items": {
              "type": "string"
            },
            "maxItems": 128,
            "minItems": 1,
            "title": "Read Columns",
            "type": "array"
          },
          "reused": {
            "default": false,
            "title": "Reused",
            "type": "boolean"
          },
          "schema_version": {
            "const": "OBJECT_ACCESS_OBSERVATION.v1",
            "default": "OBJECT_ACCESS_OBSERVATION.v1",
            "title": "Schema Version",
            "type": "string"
          },
          "scope": {
            "const": "OBJECT_AND_EXPLICIT_COLUMNS",
            "default": "OBJECT_AND_EXPLICIT_COLUMNS",
            "title": "Scope",
            "type": "string"
          },
          "source_executor_request_id": {
            "format": "uuid",
            "title": "Source Executor Request Id",
            "type": "string"
          },
          "source_query_sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "title": "Source Query Sha256",
            "type": "string"
          },
          "state": {
            "enum": [
              "READABLE",
              "DENIED",
              "OBJECT_UNAVAILABLE"
            ],
            "title": "State",
            "type": "string"
          }
        },
        "required": [
          "db_type",
          "object_ref",
          "read_columns",
          "state",
          "checked_at",
          "expires_at",
          "source_executor_request_id",
          "source_query_sha256"
        ],
        "title": "ObjectAccessObservation",
        "type": "object"
      },
      "ReadDiagnosticRequest": {
        "additionalProperties": false,
        "properties": {
          "executor_request_id": {
            "format": "uuid",
            "title": "Executor Request Id",
            "type": "string"
          },
          "grant": {
            "maxLength": 16384,
            "minLength": 64,
            "title": "Grant",
            "type": "string"
          },
          "idempotency_key": {
            "maxLength": 256,
            "minLength": 1,
            "title": "Idempotency Key",
            "type": "string"
          },
          "parameters": {
            "additionalProperties": true,
            "title": "Parameters",
            "type": "object"
          },
          "schema_version": {
            "const": "diagnostic-execution-request.v1",
            "default": "diagnostic-execution-request.v1",
            "title": "Schema Version",
            "type": "string"
          }
        },
        "required": [
          "executor_request_id",
          "grant",
          "parameters",
          "idempotency_key"
        ],
        "title": "ReadDiagnosticRequest",
        "type": "object"
      },
      "ReadDiagnosticResult": {
        "additionalProperties": false,
        "properties": {
          "error_code": {
            "anyOf": [
              {
                "maxLength": 128,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error Code"
          },
          "executor_request_id": {
            "format": "uuid",
            "title": "Executor Request Id",
            "type": "string"
          },
          "object_access": {
            "default": [],
            "items": {
              "$ref": "#/components/schemas/ObjectAccessObservation"
            },
            "maxItems": 1,
            "title": "Object Access",
            "type": "array"
          },
          "observation": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/DatabaseObservation"
              },
              {
                "type": "null"
              }
            ]
          },
          "retryable": {
            "default": false,
            "title": "Retryable",
            "type": "boolean"
          },
          "schema_version": {
            "const": "diagnostic-execution-result.v1",
            "default": "diagnostic-execution-result.v1",
            "title": "Schema Version",
            "type": "string"
          },
          "status": {
            "enum": [
              "SUCCEEDED",
              "GAP"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "executor_request_id",
          "status"
        ],
        "title": "ReadDiagnosticResult",
        "type": "object"
      },
      "ResourceRef": {
        "additionalProperties": false,
        "properties": {
          "resource_id": {
            "format": "uuid",
            "title": "Resource Id",
            "type": "string"
          },
          "resource_type": {
            "maxLength": 64,
            "minLength": 1,
            "title": "Resource Type",
            "type": "string"
          }
        },
        "required": [
          "resource_type",
          "resource_id"
        ],
        "title": "ResourceRef",
        "type": "object"
      },
      "SqlPlanCaptureExecute": {
        "additionalProperties": false,
        "properties": {
          "grant": {
            "maxLength": 16384,
            "minLength": 64,
            "title": "Grant",
            "type": "string"
          }
        },
        "required": [
          "grant"
        ],
        "title": "SqlPlanCaptureExecute",
        "type": "object"
      },
      "SqlPlanCaptureResult": {
        "additionalProperties": false,
        "properties": {
          "capture_run_id": {
            "format": "uuid",
            "title": "Capture Run Id",
            "type": "string"
          },
          "captured_at": {
            "format": "date-time",
            "title": "Captured At",
            "type": "string"
          },
          "database_type": {
            "enum": [
              "POSTGRESQL",
              "MYSQL",
              "ORACLE"
            ],
            "title": "Database Type",
            "type": "string"
          },
          "error_code": {
            "anyOf": [
              {
                "pattern": "^[A-Z][A-Z0-9_]{0,95}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error Code"
          },
          "mode": {
            "const": "ESTIMATE_ONLY",
            "default": "ESTIMATE_ONLY",
            "title": "Mode",
            "type": "string"
          },
          "native_verification": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/SqlPlanNativeVerification"
              },
              {
                "type": "null"
              }
            ]
          },
          "nodes": {
            "default": [],
            "items": {
              "$ref": "#/components/schemas/SqlPlanEstimateNode"
            },
            "maxItems": 128,
            "title": "Nodes",
            "type": "array"
          },
          "oracle_parameter_peeking": {
            "default": "NOT_APPLICABLE",
            "enum": [
              "NOT_PROVEN",
              "NOT_APPLICABLE"
            ],
            "title": "Oracle Parameter Peeking",
            "type": "string"
          },
          "original_parse_context_verified": {
            "const": false,
            "default": false,
            "title": "Original Parse Context Verified",
            "type": "boolean"
          },
          "physical_identity": {
            "additionalProperties": {
              "type": "string"
            },
            "maxProperties": 8,
            "title": "Physical Identity",
            "type": "object"
          },
          "production_execution_verified": {
            "const": false,
            "default": false,
            "title": "Production Execution Verified",
            "type": "boolean"
          },
          "representative_parameters": {
            "const": "USER_DECLARED_UNVERIFIED",
            "default": "USER_DECLARED_UNVERIFIED",
            "title": "Representative Parameters",
            "type": "string"
          },
          "request_id": {
            "format": "uuid",
            "title": "Request Id",
            "type": "string"
          },
          "schema_version": {
            "const": "SQL_PLAN_CAPTURE_RESULT.v1",
            "default": "SQL_PLAN_CAPTURE_RESULT.v1",
            "title": "Schema Version",
            "type": "string"
          },
          "status": {
            "enum": [
              "SUCCEEDED",
              "FAILED"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "capture_run_id",
          "request_id",
          "database_type",
          "status",
          "captured_at"
        ],
        "title": "SqlPlanCaptureResult",
        "type": "object"
      },
      "SqlPlanEstimateNode": {
        "additionalProperties": false,
        "properties": {
          "index_name": {
            "anyOf": [
              {
                "maxLength": 128,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Index Name"
          },
          "metrics": {
            "additionalProperties": {
              "type": "string"
            },
            "maxProperties": 24,
