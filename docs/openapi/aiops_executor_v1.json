            "type": "string"
          },
          "statement_timeout_seconds": {
            "exclusiveMinimum": 0.0,
            "title": "Statement Timeout Seconds",
            "type": "integer"
          },
          "target_id": {
            "format": "uuid",
            "title": "Target Id",
            "type": "string"
          },
          "target_row_version": {
            "minimum": 1.0,
            "title": "Target Row Version",
            "type": "integer"
          },
          "task_id": {
            "format": "uuid",
            "title": "Task Id",
            "type": "string"
          },
          "template_hash": {
            "pattern": "^[0-9a-f]{64}$",
            "title": "Template Hash",
            "type": "string"
          }
        },
        "required": [
          "grant_id",
          "task_id",
          "lease_token_hash",
          "target_id",
          "target_row_version",
          "connection_profile",
          "secret_ref",
          "diagnostic_tool_id",
          "diagnostic_tool_version",
          "template_hash",
          "max_result_rows",
          "statement_timeout_seconds",
