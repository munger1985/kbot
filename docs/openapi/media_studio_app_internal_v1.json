{
  "components": {
    "schemas": {
      "BindingUpsertRequest": {
        "additionalProperties": false,
        "properties": {
          "domain_id": {
            "minimum": 1.0,
            "title": "Domain Id",
            "type": "integer"
          },
          "expected_row_version": {
            "anyOf": [
              {
                "minimum": 1.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Expected Row Version"
          },
          "model_id": {
            "format": "uuid",
            "title": "Model Id",
            "type": "string"
          },
          "role": {
            "const": "IMAGE_GENERATION",
            "default": "IMAGE_GENERATION",
            "title": "Role",
            "type": "string"
          }
        },
        "required": [
          "domain_id",
          "model_id"
        ],
        "title": "BindingUpsertRequest",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "ImageGenerationCreateRequest": {
        "additionalProperties": false,
        "properties": {
          "aspect_ratio": {
            "default": "1:1",
            "pattern": "^[1-9][0-9]?:[1-9][0-9]?$",
            "title": "Aspect Ratio",
            "type": "string"
          },
          "count": {
            "default": 1,
            "maximum": 4.0,
            "minimum": 1.0,
            "title": "Count",
            "type": "integer"
          },
          "domain_id": {
            "minimum": 1.0,
            "title": "Domain Id",
            "type": "integer"
          },
          "prompt": {
            "maxLength": 32000,
            "minLength": 1,
            "title": "Prompt",
            "type": "string"
          }
        },
        "required": [
          "domain_id",
          "prompt"
        ],
        "title": "ImageGenerationCreateRequest",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
