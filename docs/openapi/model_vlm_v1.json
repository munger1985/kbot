    "/internal/v1/inference": {
      "post": {
        "description": "Execute VLM inference tasks.\n\nSupports single return and SSE streaming return. Follows OpenAI chat completion API specifications.\n\nArgs:\n    request: Request body containing model, message stream (including images), and sampling parameters.\n    service: VLM business logic service.\n\nReturns:\n    JSON response or SSE text stream.",
        "operationId": "run_vlm_inference_internal_v1_inference_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VLMRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VLMResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Run Vlm Inference",
        "tags": [
          "Inference"
        ]
      }
    },
