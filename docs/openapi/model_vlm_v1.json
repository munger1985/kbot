    "/api/v1/chat/completions": {
      "post": {
        "description": "把 OpenAI 多模态请求映射为内部 VLM 契约。",
        "operationId": "openai_vlm_chat_completions_api_v1_chat_completions_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OpenAIVLMRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Openai Vlm Chat Completions",
        "tags": [
          "OpenAI Compatible"
        ]
      }
    },
