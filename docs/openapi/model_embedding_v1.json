{
  "components": {
    "schemas": {
      "EmbeddingDataItem": {
        "description": "One vector returned by the embedding service.",
        "properties": {
          "embedding": {
            "description": "Embedding vector",
            "items": {
              "type": "number"
            },
            "title": "Embedding",
            "type": "array"
          },
          "index": {
            "description": "Index position in the batch",
            "title": "Index",
            "type": "integer"
          },
          "object": {
            "default": "embedding",
            "description": "Object type",
            "title": "Object",
            "type": "string"
          }
        },
        "required": [
          "embedding",
          "index"
        ],
        "title": "EmbeddingDataItem",
        "type": "object"
      },
      "EmbeddingRequest": {
        "description": "Embedding request parameter model.",
        "properties": {
          "batch_size": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": 32,
            "description": "Batch processing size",
            "title": "Batch Size"
          },
          "is_query": {
            "default": true,
            "description": "Whether the texts are query inputs",
            "title": "Is Query",
            "type": "boolean"
          },
          "served_model_name": {
            "description": "Technical name of the model (e.g., gpt-4, text-embedding-ada-002)",
            "title": "Served Model Name",
            "type": "string"
          },
          "texts": {
            "description": "List of texts to generate embeddings for",
            "items": {
              "type": "string"
            },
            "title": "Texts",
            "type": "array"
          }
        },
        "required": [
          "served_model_name",
          "texts"
        ],
        "title": "EmbeddingRequest",
        "type": "object"
      },
      "EmbeddingResponse": {
        "description": "Embedding response",
        "properties": {
          "data": {
            "description": "List of embedding data items",
            "items": {
              "$ref": "#/components/schemas/EmbeddingDataItem"
            },
            "title": "Data",
            "type": "array"
          },
          "model": {
            "description": "Name of the embedding model used",
            "title": "Model",
            "type": "string"
          },
          "object": {
            "default": "list",
            "description": "Object type (always 'list')",
            "title": "Object",
            "type": "string"
          },
          "usage": {
            "additionalProperties": {
              "type": "integer"
            },
            "description": "Token usage information",
            "title": "Usage",
            "type": "object"
          }
        },
        "required": [
          "data",
          "model",
          "usage"
        ],
        "title": "EmbeddingResponse",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "ModelCreateRequest": {
        "properties": {
          "api_endpoint": {
            "anyOf": [
              {
                "maxLength": 1024,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Api Endpoint"
          },
          "api_key": {
            "anyOf": [
              {
                "maxLength": 4096,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Api Key"
          },
          "category": {
            "exclusiveMinimum": 0.0,
            "title": "Category",
            "type": "integer"
          },
          "descs": {
            "anyOf": [
              {
                "maxLength": 512,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Descs"
          },
          "display_name": {
            "maxLength": 256,
            "minLength": 1,
            "title": "Display Name",
            "type": "string"
          },
          "embedding_dimension": {
            "anyOf": [
              {
                "exclusiveMinimum": 0.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Embedding Dimension"
          },
          "model_params": {
            "additionalProperties": true,
            "title": "Model Params",
            "type": "object"
          },
          "provider": {
            "maxLength": 64,
            "minLength": 1,
            "title": "Provider",
            "type": "string"
          },
          "provider_model_name": {
            "maxLength": 256,
            "minLength": 1,
            "title": "Provider Model Name",
            "type": "string"
          },
          "served_model_name": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
            "title": "Served Model Name",
            "type": "string"
          },
          "status": {
            "default": 0,
            "maximum": 2.0,
            "minimum": 0.0,
            "title": "Status",
            "type": "integer"
          }
        },
        "required": [
          "served_model_name",
          "display_name",
          "provider_model_name",
          "category",
          "provider"
        ],
        "title": "ModelCreateRequest",
        "type": "object"
      },
      "ModelUpdateRequest": {
        "properties": {
          "api_endpoint": {
            "anyOf": [
              {
                "maxLength": 1024,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Api Endpoint"
          },
          "api_key": {
            "anyOf": [
              {
                "maxLength": 4096,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Api Key"
          },
          "descs": {
            "anyOf": [
              {
                "maxLength": 512,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Descs"
          },
          "display_name": {
            "anyOf": [
              {
                "maxLength": 256,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Display Name"
          },
          "status": {
            "anyOf": [
              {
                "maximum": 2.0,
                "minimum": 0.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Status"
          }
        },
        "title": "ModelUpdateRequest",
        "type": "object"
      },
      "OpenAIEmbeddingRequest": {
        "description": "OpenAI 兼容的文本向量请求。",
        "properties": {
          "dimensions": {
            "anyOf": [
              {
                "exclusiveMinimum": 0.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Dimensions"
          },
          "encoding_format": {
            "const": "float",
            "default": "float",
            "title": "Encoding Format",
            "type": "string"
          },
          "input": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              }
            ],
            "title": "Input"
          },
          "model": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Model",
            "type": "string"
          }
        },
        "required": [
          "model",
          "input"
        ],
        "title": "OpenAIEmbeddingRequest",
        "type": "object"
      },
      "SimilarityRequest": {
        "description": "Similarity calculation request parameter model.",
        "properties": {
          "method": {
            "default": "cosine",
            "description": "Similarity calculation method: supports 'cosine' (cosine similarity) and 'dot' (dot product)",
            "title": "Method",
            "type": "string"
          },
          "served_model_name": {
            "description": "Technical name of the model (e.g., gpt-4, text-embedding-ada-002)",
            "title": "Served Model Name",
            "type": "string"
          },
          "text1": {
            "description": "First text string",
            "title": "Text1",
            "type": "string"
          },
          "text2": {
            "description": "Second text string",
            "title": "Text2",
            "type": "string"
          }
        },
        "required": [
          "served_model_name",
          "text1",
          "text2"
        ],
        "title": "SimilarityRequest",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Provides high-performance Text Embedding and vector similarity calculation services.",
    "title": "Embedding Microservice",
    "version": "4.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/embeddings": {
      "post": {
        "description": "按 OpenAI 请求格式生成向量。",
        "operationId": "openai_embeddings_api_v1_embeddings_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OpenAIEmbeddingRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EmbeddingResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Openai Embeddings",
        "tags": [
          "OpenAI Compatible"
        ]
      }
    },
    "/api/v1/models": {
      "get": {
        "operationId": "list_models_api_v1_models_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response List Models Api V1 Models Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "List Models",
        "tags": [
          "OpenAI Compatible"
        ]
      }
    },
    "/health": {
      "get": {
        "description": "Get the running status of the microservice and information about loaded models.\n\nReturns:\n    Dictionary containing service status, model count, and timestamp.",
        "operationId": "health_check_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Health Check Health Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health check endpoint",
        "tags": [
          "System"
        ]
      }
    },
    "/internal/v1/embeddings": {
      "post": {
        "description": "Convert input text list to vector embeddings.\n\nArgs:\n    request: Embedding request parameters including model name, text list, batch size, etc.\n    embed_service: Injected embedding service instance.\n\nReturns:\n    Response object containing embedding vectors, indices, and token usage information.\n\nRaises:\n    HTTPException: 500 error when any logical error occurs during processing.",
        "operationId": "handle_embed_texts_internal_v1_embeddings_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EmbeddingRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EmbeddingResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "文本向量化",
        "tags": [
          "AI Service"
        ]
      }
    },
    "/internal/v1/models": {
      "get": {
        "operationId": "list_models_internal_v1_models_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "List Models",
        "tags": [
          "Model Configuration"
        ]
      },
      "post": {
        "operationId": "create_model_internal_v1_models_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ModelCreateRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Create Model",
        "tags": [
          "Model Configuration"
        ]
      }
    },
    "/internal/v1/models/{model_id}": {
      "delete": {
        "operationId": "archive_model_internal_v1_models__model_id__delete",
        "parameters": [
          {
            "in": "path",
            "name": "model_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Model Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Archive Model",
        "tags": [
          "Model Configuration"
        ]
      },
      "get": {
        "operationId": "get_model_internal_v1_models__model_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "model_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Model Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Model",
        "tags": [
          "Model Configuration"
        ]
      },
      "patch": {
        "operationId": "update_model_internal_v1_models__model_id__patch",
        "parameters": [
          {
            "in": "path",
            "name": "model_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Model Id",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ModelUpdateRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Update Model",
        "tags": [
          "Model Configuration"
        ]
      }
    },
    "/internal/v1/similarity": {
      "post": {
        "description": "Calculate similarity score between two specified texts.\n\nArgs:\n    request: Request object containing model name, text pair, and calculation method (cosine/dot).\n    embed_service: Injected embedding service instance.\n\nReturns:\n    Dictionary containing similarity score.\n\nRaises:\n    HTTPException: 500 error when exception occurs during calculation.",
        "operationId": "handle_compute_similarity_internal_v1_similarity_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SimilarityRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Handle Compute Similarity Internal V1 Similarity Post",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "计算文本相似度",
        "tags": [
          "AI Service"
        ]
      }
    }
  }
}
