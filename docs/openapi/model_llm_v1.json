{
  "components": {
    "schemas": {
      "ChatRequest": {
        "description": "Chat completion request model.\n\nComprehensive request model for LLM chat completions supporting both basic\ntext generation and advanced features like tool calling, streaming, and\nfine-grained generation parameter control.",
        "properties": {
          "enable_tool_calls": {
            "default": false,
            "description": "Whether to enable tool calling functionality",
            "title": "Enable Tool Calls",
            "type": "boolean"
          },
          "frequency_penalty": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "Penalty for repetitive text (-2 to 2)",
            "title": "Frequency Penalty"
          },
          "max_tokens": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "Maximum number of tokens to generate",
            "title": "Max Tokens"
          },
          "messages": {
            "anyOf": [
              {
                "items": {
                  "additionalProperties": true,
                  "type": "object"
                },
                "type": "array"
              },
              {
                "type": "string"
              }
            ],
            "description": "List of chat messages or single prompt string",
            "title": "Messages"
          },
          "presence_penalty": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "Penalty for introducing new topics (-2 to 2)",
            "title": "Presence Penalty"
          },
          "response_format": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "description": "Response format specification",
            "title": "Response Format"
          },
          "served_model_name": {
            "description": "Name of the LLM model to use",
            "title": "Served Model Name",
            "type": "string"
          },
          "stream": {
            "default": false,
            "description": "Whether to stream response incrementally",
            "title": "Stream",
            "type": "boolean"
          },
          "temperature": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "Sampling temperature (0.0-1.0, lower=more deterministic)",
            "title": "Temperature"
          },
          "timeout": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "Request timeout in seconds",
            "title": "Timeout"
          },
          "tool_choice": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "description": "Tool selection strategy",
            "title": "Tool Choice"
          },
          "tools": {
            "anyOf": [
              {
                "items": {
                  "additionalProperties": true,
                  "type": "object"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "description": "List of tools for MCP tool calling",
            "title": "Tools"
          },
          "top_p": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "Top-p sampling parameter (0-1)",
            "title": "Top P"
          }
        },
        "required": [
          "served_model_name",
          "messages"
        ],
        "title": "ChatRequest",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
