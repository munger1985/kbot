            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Health Check Health Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health Check",
        "tags": [
          "System"
        ]
      }
    },
    "/internal/v1/chat/completions": {
      "post": {
        "description": "Handle chat completion requests, supporting streaming and non-streaming modes.\n\nArgs:\n    request: Chat request parameters.\n    service: Injected LLM service.\n\nReturns:\n    ChatResponse object or StreamingResponse for SSE.\n\nRaises:\n    HTTPException: 404 Model not found, 400 Validation error, 408 Timeout, 500 Internal server error.",
        "operationId": "handle_chat_completions_internal_v1_chat_completions_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "对话补全",
        "tags": [
          "LLM"
        ]
      }
    },
