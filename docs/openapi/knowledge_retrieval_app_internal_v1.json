            "minimum": 1.0,
            "title": "Domain Id",
            "type": "integer"
          },
          "enabled_capabilities": {
            "anyOf": [
              {
                "items": {
                  "enum": [
                    "conversation",
                    "document",
                    "data_query"
                  ],
                  "type": "string"
                },
                "maxItems": 3,
                "minItems": 1,
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Enabled Capabilities"
          },
          "expected_row_version": {
            "minimum": 1.0,
            "title": "Expected Row Version",
            "type": "integer"
          },
          "instruction": {
            "anyOf": [
              {
                "maxLength": 32000,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Instruction"
          },
          "models": {
            "anyOf": [
              {
                "additionalProperties": {
                  "format": "uuid",
                  "type": "string"
                },
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Models"
          },
          "status": {
            "anyOf": [
              {
                "enum": [
                  "DRAFT",
                  "ACTIVE",
                  "DISABLED",
                  "ARCHIVED"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Status"
          }
        },
        "required": [
          "domain_id",
          "expected_row_version"
        ],
        "title": "AgentUpdateRequest",
        "type": "object"
      },
      "GrantStatusRequest": {
        "additionalProperties": false,
        "properties": {
          "domain_id": {
            "minimum": 1.0,
            "title": "Domain Id",
            "type": "integer"
          },
          "expected_row_version": {
            "minimum": 1.0,
            "title": "Expected Row Version",
            "type": "integer"
          },
          "status": {
            "enum": [
              "ACTIVE",
              "DISABLED"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "domain_id",
          "status",
          "expected_row_version"
        ],
        "title": "GrantStatusRequest",
        "type": "object"
      },
      "GrantUpsertRequest": {
        "additionalProperties": false,
        "properties": {
          "agent_id": {
            "format": "uuid",
            "title": "Agent Id",
            "type": "string"
          },
          "domain_id": {
            "minimum": 1.0,
            "title": "Domain Id",
            "type": "integer"
          },
          "status": {
            "default": "ACTIVE",
            "enum": [
              "ACTIVE",
              "DISABLED"
            ],
            "title": "Status",
            "type": "string"
          },
          "subject_id": {
            "maxLength": 256,
            "minLength": 1,
            "title": "Subject Id",
            "type": "string"
          },
          "subject_type": {
            "enum": [
              "USER",
              "ROLE"
            ],
            "title": "Subject Type",
            "type": "string"
          }
        },
        "required": [
          "domain_id",
          "agent_id",
          "subject_type",
          "subject_id"
        ],
        "title": "GrantUpsertRequest",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
