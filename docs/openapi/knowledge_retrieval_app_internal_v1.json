{
  "components": {
    "schemas": {
      "AgentAuthorizeRequest": {
        "additionalProperties": false,
        "properties": {
          "agent_id": {
            "format": "uuid",
            "title": "Agent Id",
            "type": "string"
          },
          "domain_id": {
            "minimum": 1.0,
            "title": "Domain Id",
            "type": "integer"
          },
          "role_codes": {
            "default": [],
            "items": {
              "type": "string"
            },
            "title": "Role Codes",
            "type": "array"
          },
          "user_id": {
            "maxLength": 256,
            "minLength": 1,
            "title": "User Id",
            "type": "string"
          }
        },
        "required": [
          "domain_id",
          "agent_id",
          "user_id"
        ],
        "title": "AgentAuthorizeRequest",
        "type": "object"
      },
      "AgentCreateRequest": {
        "additionalProperties": false,
        "properties": {
          "config": {
            "additionalProperties": true,
            "title": "Config",
            "type": "object"
          },
          "description": {
            "anyOf": [
              {
                "maxLength": 1000,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Description"
          },
          "display_name": {
            "maxLength": 256,
            "minLength": 1,
            "title": "Display Name",
            "type": "string"
          },
          "do_rerank": {
            "default": false,
            "title": "Do Rerank",
            "type": "boolean"
          },
          "domain_id": {
            "minimum": 1.0,
            "title": "Domain Id",
            "type": "integer"
          },
          "enabled_capabilities": {
            "items": {
              "enum": [
                "conversation",
                "document",
                "data_query"
              ],
              "type": "string"
            },
            "maxItems": 3,
            "minItems": 1,
            "title": "Enabled Capabilities",
            "type": "array"
          },
          "instruction": {
            "anyOf": [
              {
                "maxLength": 32000,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Instruction"
          },
          "models": {
            "additionalProperties": {
              "format": "uuid",
              "type": "string"
            },
            "title": "Models",
            "type": "object"
          },
          "status": {
            "default": "DRAFT",
            "enum": [
              "DRAFT",
              "ACTIVE"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "domain_id",
          "display_name",
          "enabled_capabilities"
        ],
        "title": "AgentCreateRequest",
        "type": "object"
      },
      "AgentUpdateRequest": {
        "additionalProperties": false,
        "properties": {
          "config": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Config"
          },
          "description": {
            "anyOf": [
              {
                "maxLength": 1000,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Description"
          },
          "display_name": {
            "anyOf": [
              {
                "maxLength": 256,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
