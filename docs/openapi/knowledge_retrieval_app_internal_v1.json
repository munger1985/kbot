                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Status"
          }
        },
        "required": [
          "domain_id",
          "expected_row_version"
        ],
        "title": "AgentUpdateRequest",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "ResearchCreateRequest": {
        "additionalProperties": false,
        "properties": {
          "agent_id": {
            "format": "uuid",
            "title": "Agent Id",
            "type": "string"
          },
          "allowed_x_handles": {
            "default": [],
            "items": {
              "type": "string"
            },
            "maxItems": 20,
            "title": "Allowed X Handles",
            "type": "array"
          },
          "domain_id": {
            "minimum": 1.0,
            "title": "Domain Id",
            "type": "integer"
          },
          "enable_image_understanding": {
            "default": false,
            "title": "Enable Image Understanding",
            "type": "boolean"
          },
          "enable_video_understanding": {
            "default": false,
            "title": "Enable Video Understanding",
            "type": "boolean"
          },
          "excluded_x_handles": {
            "default": [],
            "items": {
              "type": "string"
            },
            "maxItems": 20,
            "title": "Excluded X Handles",
            "type": "array"
          },
          "from_date": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "From Date"
          },
          "input": {
            "maxLength": 32000,
            "minLength": 1,
            "title": "Input",
            "type": "string"
          },
          "model_id": {
            "format": "uuid",
            "title": "Model Id",
            "type": "string"
          },
          "search_context_size": {
            "default": "MEDIUM",
            "enum": [
              "LOW",
              "MEDIUM",
              "HIGH"
            ],
            "title": "Search Context Size",
            "type": "string"
          },
          "to_date": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "To Date"
          }
        },
        "required": [
          "domain_id",
          "model_id",
          "agent_id",
          "input"
        ],
        "title": "ResearchCreateRequest",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
