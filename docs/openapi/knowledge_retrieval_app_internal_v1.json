          },
          "description": {
            "anyOf": [
              {
                "maxLength": 1000,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Description"
          },
          "display_name": {
            "anyOf": [
              {
                "maxLength": 256,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Display Name"
          },
          "domain_id": {
            "minimum": 1.0,
            "title": "Domain Id",
            "type": "integer"
          },
          "expected_row_version": {
            "minimum": 1.0,
            "title": "Expected Row Version",
            "type": "integer"
          },
          "instruction": {
            "anyOf": [
              {
                "maxLength": 32000,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Instruction"
          },
          "knowledge_core_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Knowledge Core Id"
          },
          "models": {
            "anyOf": [
              {
                "additionalProperties": {
                  "format": "uuid",
                  "type": "string"
                },
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Models"
          },
