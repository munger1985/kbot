      "SlackWebhookEnvelope": {
        "additionalProperties": false,
        "description": "保真传递 Slack 原始正文和验签 Header。",
        "properties": {
          "content_type": {
            "maxLength": 256,
            "minLength": 1,
            "title": "Content Type",
            "type": "string"
          },
          "raw_body_base64": {
            "maxLength": 30000000,
            "minLength": 1,
            "title": "Raw Body Base64",
            "type": "string"
          },
          "raw_body_hash": {
            "pattern": "^[0-9a-f]{64}$",
            "title": "Raw Body Hash",
            "type": "string"
          },
          "received_at": {
            "format": "date-time",
            "title": "Received At",
            "type": "string"
          },
          "request_id": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Request Id",
            "type": "string"
          },
          "schema_version": {
            "default": "slack.webhook.internal.v1",
            "title": "Schema Version",
            "type": "string"
          },
          "signature_headers": {
            "additionalProperties": {
              "type": "string"
            },
            "title": "Signature Headers",
            "type": "object"
          }
        },
        "required": [
          "request_id",
          "raw_body_base64",
          "raw_body_hash",
          "content_type",
          "received_at"
        ],
        "title": "SlackWebhookEnvelope",
        "type": "object"
      },
      "SlackWebhookReceipt": {
        "additionalProperties": false,
        "description": "KM Asset 完成验签和 Inbox 落库后的内部回执。",
        "properties": {
          "accepted": {
            "title": "Accepted",
            "type": "boolean"
          },
          "challenge": {
            "anyOf": [
              {
                "type": "string"
              },
