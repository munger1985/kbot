            "type": "integer"
          },
          "expected_row_version": {
            "minimum": 1.0,
            "title": "Expected Row Version",
            "type": "integer"
          }
        },
        "required": [
          "domain_id",
          "expected_row_version"
        ],
        "title": "AgentActivateRequest",
        "type": "object"
      },
      "AgentCreateRequest": {
        "additionalProperties": false,
        "properties": {
          "description": {
            "anyOf": [
              {
                "maxLength": 1000,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Description"
          },
          "display_name": {
            "maxLength": 256,
            "minLength": 1,
            "title": "Display Name",
            "type": "string"
          },
          "do_rerank": {
            "default": false,
            "title": "Do Rerank",
            "type": "boolean"
          },
          "domain_id": {
            "minimum": 1.0,
            "title": "Domain Id",
            "type": "integer"
          },
          "instruction": {
            "anyOf": [
              {
                "maxLength": 32000,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Instruction"
          },
          "models": {
            "additionalProperties": {
              "format": "uuid",
              "type": "string"
            },
            "title": "Models",
            "type": "object"
          },
          "source_id": {
            "format": "uuid",
            "title": "Source Id",
            "type": "string"
          },
          "status": {
            "default": "DRAFT",
            "pattern": "^(DRAFT|ACTIVE)$",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "domain_id",
          "source_id",
          "display_name"
        ],
        "title": "AgentCreateRequest",
        "type": "object"
      },
      "AgentUpdateRequest": {
        "additionalProperties": false,
        "properties": {
          "description": {
            "anyOf": [
              {
                "maxLength": 1000,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Description"
          },
          "display_name": {
            "maxLength": 256,
            "minLength": 1,
            "title": "Display Name",
            "type": "string"
          },
          "do_rerank": {
            "default": false,
            "title": "Do Rerank",
            "type": "boolean"
          },
          "domain_id": {
            "minimum": 1.0,
            "title": "Domain Id",
            "type": "integer"
          },
          "expected_row_version": {
            "minimum": 1.0,
            "title": "Expected Row Version",
            "type": "integer"
          },
          "instruction": {
            "anyOf": [
              {
                "maxLength": 32000,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Instruction"
          },
          "models": {
            "additionalProperties": {
              "format": "uuid",
              "type": "string"
            },
            "title": "Models",
            "type": "object"
          },
          "source_id": {
            "format": "uuid",
            "title": "Source Id",
            "type": "string"
          }
        },
        "required": [
