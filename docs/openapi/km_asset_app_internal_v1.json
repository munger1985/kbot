          },
          "duplicate": {
            "title": "Duplicate",
            "type": "boolean"
          },
          "ignored": {
            "default": false,
            "title": "Ignored",
            "type": "boolean"
          },
          "receipt_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Receipt Id"
          },
          "schema_version": {
            "default": "slack.webhook.internal.v1",
            "title": "Schema Version",
            "type": "string"
          }
        },
        "required": [
          "receipt_id",
          "accepted",
          "duplicate"
        ],
        "title": "SlackWebhookReceipt",
        "type": "object"
      },
      "SourceCreateRequest": {
        "additionalProperties": false,
        "properties": {
          "batch_size": {
            "default": 100,
            "maximum": 1000.0,
            "minimum": 1.0,
            "title": "Batch Size",
