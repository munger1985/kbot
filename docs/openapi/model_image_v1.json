              {
                "maxLength": 256,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Provider Request Id"
          },
          "schema_version": {
            "const": "ImageGenerationResult.v1",
            "default": "ImageGenerationResult.v1",
            "title": "Schema Version",
            "type": "string"
          },
          "status": {
            "enum": [
              "COMPLETED",
              "REJECTED",
              "FAILED"
            ],
            "title": "Status",
            "type": "string"
          },
          "usage": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ModelUsage"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "status"
        ],
        "title": "ImageGenerationResult",
        "type": "object"
      },
