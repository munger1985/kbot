{
  "components": {
    "schemas": {
      "GeneratedImageArtifact": {
        "additionalProperties": false,
        "description": "仅在服务间传输图片字节；业务 App 必须立即转存至对象存储。",
        "properties": {
          "content": {
            "format": "base64url",
            "maxLength": 33554432,
            "minLength": 1,
            "title": "Content",
            "type": "string"
          },
          "height": {
            "anyOf": [
              {
                "maximum": 16384.0,
                "minimum": 1.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Height"
          },
          "mime_type": {
            "pattern": "^image/(png|jpeg|webp)$",
            "title": "Mime Type",
            "type": "string"
          },
          "provider_artifact_id": {
            "anyOf": [
              {
                "maxLength": 256,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Provider Artifact Id"
          },
          "width": {
            "anyOf": [
              {
                "maximum": 16384.0,
                "minimum": 1.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Width"
          }
        },
        "required": [
          "mime_type",
          "content"
        ],
        "title": "GeneratedImageArtifact",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "ImageGenerationRequest": {
        "additionalProperties": false,
        "description": "由业务 App 发给模型服务的一次受控文生图请求。",
        "properties": {
          "aspect_ratio": {
            "default": "1:1",
            "pattern": "^[1-9][0-9]?:[1-9][0-9]?$",
            "title": "Aspect Ratio",
            "type": "string"
          },
          "count": {
            "default": 1,
            "maximum": 4.0,
            "minimum": 1.0,
            "title": "Count",
            "type": "integer"
          },
          "model_id": {
            "format": "uuid",
            "title": "Model Id",
            "type": "string"
          },
          "prompt": {
            "maxLength": 32000,
            "minLength": 1,
            "title": "Prompt",
            "type": "string"
          },
          "schema_version": {
            "const": "ImageGenerationRequest.v1",
            "default": "ImageGenerationRequest.v1",
            "title": "Schema Version",
            "type": "string"
          },
          "trace_id": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Trace Id",
            "type": "string"
          }
        },
        "required": [
          "model_id",
          "prompt",
          "trace_id"
        ],
        "title": "ImageGenerationRequest",
        "type": "object"
      },
      "ImageGenerationResult": {
        "additionalProperties": false,
        "description": "模型服务返回给业务 App 的文生图终态。",
        "properties": {
          "artifacts": {
            "default": [],
            "items": {
              "$ref": "#/components/schemas/GeneratedImageArtifact"
