{
  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "OutputAuthorityRequest": {
        "additionalProperties": false,
        "properties": {
          "actor_id": {
            "maxLength": 256,
            "minLength": 1,
            "title": "Actor Id",
            "type": "string"
          },
          "domain_id": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Domain Id",
            "type": "string"
          },
          "job_id": {
            "format": "uuid",
            "title": "Job Id",
            "type": "string"
          },
          "job_type": {
            "enum": [
              "REPORT_GENERATION",
              "CASE_EXTRACTION"
            ],
            "title": "Job Type",
            "type": "string"
          },
          "origin": {
            "const": "HUMAN",
            "title": "Origin",
            "type": "string"
          },
          "source": {
            "$ref": "#/components/schemas/OutputJobSource"
          },
          "source_agent_ids": {
            "items": {
              "format": "uuid",
              "type": "string"
            },
            "maxItems": 512,
            "minItems": 1,
            "title": "Source Agent Ids",
            "type": "array"
          },
          "tenant_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Tenant Id"
          }
        },
        "required": [
          "job_id",
          "job_type",
          "source",
          "origin",
          "actor_id",
          "domain_id",
          "source_agent_ids"
        ],
        "title": "OutputAuthorityRequest",
        "type": "object"
      },
      "OutputAuthoritySnapshot": {
        "additionalProperties": false,
        "description": "仅在本次阶段使用；下一阶段、完成和重试均须重新查询。",
        "properties": {
          "checked_at": {
            "format": "date-time",
            "title": "Checked At",
            "type": "string"
          },
          "domain_code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Domain Code"
          },
          "max_security_level": {
            "anyOf": [
              {
                "maximum": 5.0,
                "minimum": 0.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Max Security Level"
          },
          "permissions": {
            "items": {
              "type": "string"
            },
            "title": "Permissions",
            "type": "array"
          },
          "request": {
            "$ref": "#/components/schemas/OutputAuthorityRequest"
          }
        },
        "required": [
          "request",
          "permissions",
          "checked_at"
        ],
        "title": "OutputAuthoritySnapshot",
        "type": "object"
      },
      "OutputJobSource": {
        "additionalProperties": false,
        "properties": {
          "conversation_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Conversation Id"
          },
          "kind": {
            "enum": [
              "CONVERSATION",
              "RUN",
              "REPORT"
            ],
            "title": "Kind",
            "type": "string"
          },
          "report_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Report Id"
          },
          "run_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Run Id"
          },
          "source_id": {
            "format": "uuid",
            "title": "Source Id",
            "type": "string"
          }
        },
        "required": [
          "kind",
          "source_id"
        ],
        "title": "OutputJobSource",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "KBot Main API Internal Contract",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/internal/v1/platform/aiops/output-authority": {
      "post": {
        "operationId": "resolve_output_authority_internal_v1_platform_aiops_output_authority_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OutputAuthorityRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OutputAuthoritySnapshot"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Resolve Output Authority",
        "tags": [
          "AIOps Output Authority"
        ]
      }
    }
  }
}
