            "title": "Aspect Ratio",
            "type": "string"
          },
          "count": {
            "default": 1,
            "maximum": 4.0,
            "minimum": 1.0,
            "title": "Count",
            "type": "integer"
          },
          "domain_id": {
            "minimum": 1.0,
            "title": "Domain Id",
            "type": "integer"
          },
          "prompt": {
            "maxLength": 32000,
            "minLength": 1,
