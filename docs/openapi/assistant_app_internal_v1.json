                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Status"
          }
        },
        "required": [
          "domain_id",
          "expected_row_version"
        ],
        "title": "AgentUpdateRequest",
        "type": "object"
      },
      "BindingUpsertRequest": {
        "additionalProperties": false,
        "properties": {
          "domain_id": {
            "minimum": 1.0,
            "title": "Domain Id",
            "type": "integer"
          },
          "expected_row_version": {
