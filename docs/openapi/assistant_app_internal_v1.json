{
  "components": {
    "schemas": {
      "AgentCreateRequest": {
        "additionalProperties": false,
        "properties": {
          "config": {
            "additionalProperties": true,
            "title": "Config",
            "type": "object"
          },
          "data_model_ids": {
            "default": [],
            "items": {
              "format": "uuid",
              "type": "string"
            },
            "maxItems": 100,
            "title": "Data Model Ids",
            "type": "array"
          },
          "description": {
            "anyOf": [
              {
                "maxLength": 1000,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Description"
          },
          "display_name": {
            "maxLength": 256,
            "minLength": 1,
            "title": "Display Name",
            "type": "string"
          },
          "domain_id": {
            "minimum": 1.0,
            "title": "Domain Id",
            "type": "integer"
          },
          "instruction": {
            "anyOf": [
              {
                "maxLength": 32000,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Instruction"
          },
          "knowledge_core_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Knowledge Core Id"
          },
          "models": {
            "additionalProperties": {
              "format": "uuid",
              "type": "string"
            },
            "title": "Models",
            "type": "object"
          },
          "status": {
            "default": "DRAFT",
            "enum": [
              "DRAFT",
              "ACTIVE"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "domain_id",
          "display_name"
        ],
        "title": "AgentCreateRequest",
        "type": "object"
      },
      "AgentUpdateRequest": {
        "additionalProperties": false,
        "properties": {
          "config": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Config"
          },
          "data_model_ids": {
            "items": {
              "format": "uuid",
              "type": "string"
            },
            "maxItems": 100,
            "title": "Data Model Ids",
            "type": "array"
          },
          "description": {
            "anyOf": [
              {
                "maxLength": 1000,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Description"
          },
          "display_name": {
            "anyOf": [
              {
                "maxLength": 256,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Display Name"
          },
          "domain_id": {
            "minimum": 1.0,
            "title": "Domain Id",
            "type": "integer"
          },
          "expected_row_version": {
            "minimum": 1.0,
            "title": "Expected Row Version",
            "type": "integer"
          },
          "instruction": {
            "anyOf": [
              {
                "maxLength": 32000,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Instruction"
          },
          "knowledge_core_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Knowledge Core Id"
          },
          "models": {
            "anyOf": [
              {
                "additionalProperties": {
                  "format": "uuid",
                  "type": "string"
                },
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Models"
          },
          "status": {
            "anyOf": [
              {
                "enum": [
                  "DRAFT",
                  "ACTIVE",
                  "DISABLED",
                  "ARCHIVED"
