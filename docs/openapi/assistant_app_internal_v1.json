            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "ImageGenerationCreateRequest": {
        "additionalProperties": false,
        "properties": {
          "aspect_ratio": {
            "default": "1:1",
