      "PlanDraft": {
        "additionalProperties": false,
        "description": "Planner 输出的不可执行计划草案。",
        "properties": {
          "expires_at": {
            "format": "date-time",
            "title": "Expires At",
            "type": "string"
          },
          "final_task_key": {
            "maxLength": 64,
            "minLength": 1,
            "title": "Final Task Key",
