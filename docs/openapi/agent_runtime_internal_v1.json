            "anyOf": [
              {
                "$ref": "#/components/schemas/AgentArtifactRef"
              },
              {
                "type": "null"
              }
            ]
          },
          "row_version": {
            "minimum": 1.0,
            "title": "Row Version",
            "type": "integer"
          },
          "run_id": {
            "format": "uuid",
            "title": "Run Id",
            "type": "string"
          },
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
