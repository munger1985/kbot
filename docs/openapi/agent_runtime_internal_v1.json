      "ClaimTaskRequest": {
        "additionalProperties": false,
        "properties": {
          "lease_seconds": {
            "default": 120,
            "maximum": 3600.0,
            "minimum": 15.0,
            "title": "Lease Seconds",
            "type": "integer"
          },
          "worker_id": {
            "maxLength": 256,
            "minLength": 1,
            "title": "Worker Id",
            "type": "string"
          }
        },
        "required": [
          "worker_id"
