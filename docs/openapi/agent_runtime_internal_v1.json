        "type": "object"
      },
      "ArtifactInput": {
        "additionalProperties": false,
        "properties": {
          "artifact_type": {
            "maxLength": 64,
            "minLength": 1,
            "title": "Artifact Type",
            "type": "string"
          },
          "expires_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Expires At"
          },
          "payload": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "items": {},
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Payload"
          },
          "producer": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Producer",
            "type": "string"
          },
          "producer_version": {
            "maxLength": 64,
            "minLength": 1,
            "title": "Producer Version",
            "type": "string"
          },
          "provenance": {
            "additionalProperties": true,
            "title": "Provenance",
            "type": "object"
          },
          "schema_version": {
            "maxLength": 64,
            "minLength": 1,
            "title": "Schema Version",
            "type": "string"
          },
          "security_level": {
            "default": 0,
            "maximum": 999.0,
            "minimum": 0.0,
            "title": "Security Level",
            "type": "integer"
          },
          "storage_uri": {
            "anyOf": [
              {
                "maxLength": 2048,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Storage Uri"
          }
        },
        "required": [
          "artifact_type",
          "schema_version",
          "producer",
          "producer_version"
        ],
