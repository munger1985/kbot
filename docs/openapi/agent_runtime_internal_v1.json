          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "payload": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "items": {},
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Payload"
          },
          "producer": {
            "title": "Producer",
            "type": "string"
          },
          "producer_version": {
