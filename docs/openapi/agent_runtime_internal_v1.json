            "title": "Tasks",
            "type": "array"
          }
        },
        "required": [
          "plan_version",
          "objective",
          "tasks",
          "final_task_key",
          "expires_at"
        ],
        "title": "PlanDraft",
        "type": "object"
      },
      "TaskSpec": {
        "additionalProperties": false,
        "description": "Planner 允许生成的单个类型化任务。",
        "properties": {
          "completion_requirement": {
            "$ref": "#/components/schemas/CompletionRequirement",
            "default": "REQUIRED"
          },
          "delegate_capability": {
            "anyOf": [
              {
                "maxLength": 128,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Delegate Capability"
          },
          "delegate_service": {
            "anyOf": [
              {
                "maxLength": 128,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Delegate Service"
          },
          "depends_on": {
            "default": [],
            "items": {
              "type": "string"
            },
            "title": "Depends On",
            "type": "array"
          },
          "execution_kind": {
            "$ref": "#/components/schemas/ExecutionKind"
          },
          "execution_mode": {
            "$ref": "#/components/schemas/ExecutionMode"
          },
          "expected_outputs": {
            "default": [],
            "items": {
              "type": "string"
            },
            "title": "Expected Outputs",
            "type": "array"
          },
          "input_refs": {
            "default": [],
            "items": {
              "type": "string"
            },
            "title": "Input Refs",
            "type": "array"
          },
          "max_retries": {
            "default": 0,
            "maximum": 10.0,
            "minimum": 0.0,
            "title": "Max Retries",
            "type": "integer"
          },
          "required_scopes": {
            "default": [],
            "items": {
              "type": "string"
            },
            "title": "Required Scopes",
            "type": "array"
          },
          "skill_id": {
            "anyOf": [
              {
                "pattern": "^[a-z][a-z0-9-]{0,127}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Skill Id"
          },
          "skill_version": {
            "anyOf": [
              {
                "maxLength": 64,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Skill Version"
          },
          "specialist": {
            "anyOf": [
              {
                "maxLength": 64,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Specialist"
          },
          "task_key": {
            "pattern": "^[a-z][a-z0-9_-]{0,63}$",
            "title": "Task Key",
            "type": "string"
          },
          "task_type": {
            "maxLength": 64,
            "minLength": 1,
            "title": "Task Type",
            "type": "string"
          },
          "timeout_seconds": {
            "maximum": 3600.0,
            "minimum": 1.0,
            "title": "Timeout Seconds",
            "type": "integer"
          }
        },
        "required": [
          "task_key",
          "task_type",
          "execution_kind",
          "timeout_seconds",
          "execution_mode"
        ],
        "title": "TaskSpec",
        "type": "object"
      },
