          },
          "worker_id": {
            "maxLength": 256,
            "minLength": 1,
            "title": "Worker Id",
            "type": "string"
          }
        },
        "required": [
          "expected_row_version",
          "worker_id",
          "lease_token",
          "error_code",
          "error_message"
