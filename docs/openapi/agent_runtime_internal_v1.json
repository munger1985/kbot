      "CreateAgentDefinitionRequest": {
        "additionalProperties": false,
        "properties": {
          "agent_key": {
            "pattern": "^[a-z][a-z0-9._-]{0,127}$",
            "title": "Agent Key",
            "type": "string"
          },
          "composer_model_name": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Composer Model Name",
            "type": "string"
          },
          "config": {
            "additionalProperties": true,
            "title": "Config",
            "type": "object"
          },
          "description": {
            "anyOf": [
              {
                "maxLength": 1000,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Description"
          },
          "display_name": {
            "maxLength": 256,
            "minLength": 1,
            "title": "Display Name",
            "type": "string"
          },
          "enabled_capabilities": {
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "title": "Enabled Capabilities",
            "type": "array"
          },
          "instruction": {
            "anyOf": [
              {
                "maxLength": 32000,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Instruction"
          },
          "router_model_name": {
            "anyOf": [
              {
                "maxLength": 128,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Router Model Name"
          },
          "status": {
            "default": "DRAFT",
            "pattern": "^(DRAFT|ACTIVE)$",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "agent_key",
          "display_name",
          "enabled_capabilities",
          "composer_model_name"
        ],
        "title": "CreateAgentDefinitionRequest",
        "type": "object"
      },
      "CreateAgentRunRequest": {
        "additionalProperties": false,
        "description": "公开请求经 Main API 认证后转发的 Run 创建参数。",
        "properties": {
          "agent_id": {
            "format": "uuid",
            "title": "Agent Id",
            "type": "string"
          },
          "client_metadata": {
            "additionalProperties": true,
            "title": "Client Metadata",
            "type": "object"
          },
          "collection_ids": {
            "default": [],
            "items": {
              "format": "uuid",
              "type": "string"
