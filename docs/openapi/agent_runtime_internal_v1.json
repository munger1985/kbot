        "title": "ExecutionMode",
        "type": "string"
      },
      "FailTaskRequest": {
        "additionalProperties": false,
        "properties": {
          "error_code": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Error Code",
            "type": "string"
          },
          "error_message": {
            "maxLength": 1000,
            "minLength": 1,
