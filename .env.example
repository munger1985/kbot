# KBot 4.0 Secret 模板。
# 本地开发可复制为 .env；生产环境使用 systemd EnvironmentFile 或容器 Secret。

# Oracle 登录密码。
KBOT_ORACLE_PASSWORD=""

# 至少 32 字节的随机主密钥。KBot 会按用途派生内部 JWT、API Pepper、
# 凭证加密、AIOps 审批、Cursor 与 Webhook 签名密钥。
KBOT_MASTER_KEY=""

# 可选：SelectAI/AIReport 问数服务 API Key。
KBOT_MCP_DATA_API_KEY=""

# 可选：AIOps environment Secret Provider 示例。
AIOPS_DEMO_ORACLE_READONLY=""
AIOPS_DEMO_PROMETHEUS='{"token":"","webhook_secret":""}'
