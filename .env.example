# KBot 4.0 Secret 模板。
# 本地开发可复制为 .env；生产环境使用 systemd EnvironmentFile 或容器 Secret。

# Oracle 登录密码。
KBOT_ORACLE_PASSWORD=""

# 至少 32 字节的随机主密钥。KBot 会按用途派生内部 JWT、API Pepper、
# 凭证加密、AIOps 审批、Cursor 与 Webhook 签名密钥。
KBOT_MASTER_KEY=""

# 数据库托管凭据统一使用的 AES-256-GCM 密钥。未显式填写时由
# KBOT_MASTER_KEY 按用途派生；生产轮换时同步更新版本号。
KBOT_MANAGED_CREDENTIAL_KEY=""
KBOT_MANAGED_CREDENTIAL_KEY_VERSION="2026-08"

# 可选：SelectAI/AIReport 问数服务 API Key。
KBOT_MCP_DATA_API_KEY=""

# 可选：Slack Events API。仅在 integrations.slack.enabled=true 时需要。
# 这里只保存敏感凭证；功能开关、Workspace 映射和回复策略配置在 kbot.toml。
KBOT_SLACK_SIGNING_SECRET=""
KBOT_SLACK_BOT_TOKEN=""
# 只供 Slack Worker 调用公开 Main API；必须绑定 KM Portal 用户并授权指定 Agent。
KBOT_SLACK_KM_API_KEY=""
