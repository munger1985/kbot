# KBot 4.0 Secret 模板。
# 本地开发可复制为 .env；生产环境使用 systemd EnvironmentFile 或容器 Secret。

# Oracle 登录密码。
KBOT_ORACLE_PASSWORD=""

# 至少 32 字节的随机主密钥。KBot 会按用途派生内部 JWT、API Pepper、
# 凭证加密、AIOps 审批、Cursor 与 Webhook 签名密钥。
KBOT_MASTER_KEY=""

# AIOps Target 数据库凭据专用 AES-256-GCM 密钥。填写 Base64URL 编码的 32 字节随机值，
# 不得复用 KBOT_MASTER_KEY 或认证用途密钥。
KBOT_AIOPS_CREDENTIAL_ENCRYPTION_KEY=""
KBOT_AIOPS_CREDENTIAL_KEY_VERSION="2026-08"
KBOT_DATA_QUERY_CREDENTIAL_ENCRYPTION_KEY=""
KBOT_DATA_QUERY_CREDENTIAL_KEY_VERSION="2026-08"

# 可选：SelectAI/AIReport 问数服务 API Key。
KBOT_MCP_DATA_API_KEY=""

# 监控源的 SecretRef 示例；数据库 Target 凭据不使用环境变量。
KBOT_AIOPS_DEMO_PROMETHEUS='{"token":"","webhook_secret":""}'

# 可选：Slack Events API。仅在 integrations.slack.enabled=true 时需要。
KBOT_SLACK_SIGNING_SECRET=""
KBOT_SLACK_BOT_TOKEN=""
