# 部署时必须生成独立密钥，不要直接使用示例值
# 模型凭证字段加密密钥
KBOT_AUTH_ENCRYPTION_KEY=""
# Portal API Key 摘要使用的服务端 Pepper
KBOT_API_KEY_PEPPER=""
# 内部调用同时要求静态服务凭据和短期 AuthContext JWT
KBOT_INTERNAL_SERVICE_TOKEN=""
KBOT_INTERNAL_JWT_SECRET=""

ENVIRONMENT="development"
CONFIG_DIR="/home/ubuntu/kbot3/configuration"

TESSDATA_PREFIX="/home/ubuntu/miniconda3/envs/kbot3/share/"
