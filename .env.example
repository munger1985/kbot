# KBot 4.0 进程环境变量模板。
# 本地开发复制为 .env；生产环境应由 systemd、容器 Secret 或 Vault 注入。

# 配置选择
ENVIRONMENT="development"
CONFIG_DIR="/absolute/path/to/kbot/configuration"
# 可选：配置加载器默认读取当前目录的 .env。
# ENV_FILE="/etc/kbot/kbot.env"

# Oracle 密码。用户名、主机、端口和 Service Name 保存在 TOML。
KBOT_ORACLE_PASSWORD=""

# 模型厂商凭证在数据库中加密保存；此值是统一的 AES-GCM 主密钥。
KBOT_AUTH_ENCRYPTION_KEY=""

# Portal/Model API Key 摘要的服务端 Pepper。
KBOT_API_KEY_PEPPER=""

# 内部服务静态凭证和短期 AuthContext JWT 签名密钥。
KBOT_INTERNAL_SERVICE_TOKEN=""
KBOT_INTERNAL_JWT_SECRET=""
