# KBot 生产部署只需要填写本文件和 Secret 环境变量。
environment = "production"
data_dir = "/var/lib/kbot"
log_dir = "/var/log/kbot"
embedding_dimension = 2048
# 是否启用 Main API 的离线 Swagger UI（/docs）和 ReDoc（/redoc）。
api_docs_enabled = false
# 允许浏览器直接访问 Main API 的来源。必须精确匹配 scheme、主机和端口，不要带末尾斜杠。
# api_allowed_origins = ["https://portal.example.com"]
# 若需要允许任意网页来源，可设置：api_allowed_origins = ["*"]
# 平台用户 Token 默认有效期为 8 小时。签名密钥由 KBOT_MASTER_KEY 自动派生；
# 只有需要单独轮换时才显式设置 KBOT_USER_JWT_SECRET（至少 32 字节）。

[ui]
# 浏览器访问 Main API 的公开地址，由 UI 服务读取并注入页面，用户不能在登录页修改。
main_api_base_url = "http://kbot.example.com:18099"

[database]
host = "oracle.example.internal"
port = 1521
service_name = "kbot4"
username = "kbot"

# 只有向 KBot 以外的系统开放模型 API 时才增加。
# [[model_api_keys]]
# key_id = "model-client"
# client_id = "external-model-client"
# key_digest = "生成的64位摘要"

# Docling 模型默认位于 <data_dir>/models/docling_models。
# 若使用其他挂载点，取消下面两行注释。
# [paths]
# docling_models = "/opt/kbot/models/docling_models"

# Main API 通知投影和 SSE 的资源边界；单机默认值通常无需修改。
# [notifications]
# dispatcher_batch_size = 50
# dispatcher_lease_seconds = 60
# dispatcher_max_attempts = 5
# dispatcher_poll_seconds = 1.0
# sse_poll_interval_seconds = 1.0
# sse_heartbeat_seconds = 15.0

# 单机部署无需配置 endpoints。只有服务分散到不同主机时才覆盖对应地址。
# [endpoints]
# knowledge_core = "http://knowledge-core.internal:18090"
# knowledge_retrieval_app = "http://knowledge-retrieval-app.internal:18150"
# km_asset_app = "http://km-asset-app.internal:18160"
# agent_runtime = "http://agent-runtime.internal:18100"
# aiops = "http://aiops.internal:18110"
# aiops_db_executor = "http://aiops.internal:18111"
# model_embedding = "http://models.internal:18091"
# model_llm = "http://models.internal:18092"
# model_visual = "http://models.internal:18093"
# model_vlm = "http://models.internal:18094"
# model_ocr = "http://models.internal:18096"

# 以下集成均为可选项，未启用时无需填写。
# [integrations.mcp_data]
# api_endpoint = "http://aireport.internal:10090/aireport/chat/with_selectai_api"
# profiles_endpoint = "http://aireport.internal:10090/aireport/admin/list_profiles"

# [integrations.deepseek_ocr]
# enabled = true
# api_endpoint = "http://deepseek-ocr.internal:18097/v1/chat/completions"
# ocr_model = "deepseek-ocr"

# Slack Events API 集成。Signing Secret 与 Bot Token 只通过下方指定的环境变量注入。
# [integrations.slack]
# enabled = true
# max_webhook_bytes = 1048576
# requests_per_minute = 120
# outbox_poll_interval_seconds = 1
# lease_seconds = 60
# max_delivery_attempts = 8

# [[integrations.slack.workspaces]]
# workspace_id = "T0123456789"
# domain_id = 1001
# agent_id = "019fcbe0-e46c-7d33-907b-9d1621a2998f"
# security_level = 1
# signing_secret_env = "KBOT_SLACK_SIGNING_SECRET"
# bot_token_env = "KBOT_SLACK_BOT_TOKEN"

# [integrations.slack.external_callback]
# enabled = true
# url = "https://callback.example.com/events"
# timeout_seconds = 10

# 两项调试功能会落盘完整业务报文，只能临时开启。
# [integrations.slack.debug]
# callback_payload_log_enabled = false
# slack_reply_dump_enabled = false
# slack_reply_dump_dir = "/tmp/slackmess"

# Slack 中 Asset问答助手的最终回复展示策略。非 READY 状态始终显示；无文档问数
# 最多展示 max_references 个 Asset，或 DOCUMENT 引用超过该值时显示统一截断提示；
# Asset 回复使用 km_portal_base_url 与 URL 编码后的 asset_id 拼接 KM Link。
# [integrations.slack.reply]
# assistant_name = "Asset问答助手"
# max_references = 10
# show_warnings = true
# show_query_result_summary = true
# show_visualization_notice = true
# km_portal_base_url = "https://apex.oraclecorp.com/pls/apex/f?p=2018:130:::::P130_SUB,P130_ASSET_ID:SP,"
