{
  "embed": {
    "service_name": "embedding-service",
    "service_version": "1.0.0",
    "service_host": "0.0.0.0",
    "service_port": 9201,
    "max_tokens": 8192,
    "timeout": 30,
    "max_retries": 3,
    "cache_dir": "/your/path/cached_models/"
  },
  "llm": {
    "service_name": "llm-service",
    "service_version": "1.0.0",
    "service_host": "0.0.0.0",
    "service_port": 9202,
    "max_tokens": 8192,
    "temperature": 0.7,
    "top_p": 1.0,
    "top_k": 0,
    "timeout": 30,
    "frequency_penalty": 0.0,
    "presence_penalty": 0.0
  },
  "reranker": {
    "service_name": "reranker-service",
    "service_version": "1.0.0",
    "service_host": "0.0.0.0",
    "service_port": 9203,
    "cache_dir": "/your/path/cached_models/",
    "timeout": 30
  },
  "vlm": {
    "service_name": "vlm-service",
    "service_version": "1.0.0",
    "service_host": "0.0.0.0",
    "service_port": 9204,
    "timeout": 30
  },
  "tokenizer": {
    "custom_dict_path": "/your/path/kbot3/configuration/custom_dict.txt",
    "stop_words_path": "/your/path/kbot3/configuration/stopwords.txt"
  },
  "synonym": {
    "service_name": "synonym-service",
    "service_version": "1.0.0",
    "service_host": "0.0.0.0",
    "service_port": 9205,
    "timeout": 30,
    "enabled": false,
    "model_path": "/your/path/cached_models/cc.zh.300.bin",
    "top_n_words": 50000,
    "preload_top": 1000
  }
}