[api]
service_name = "kbot-main-api"
service_version = "4.0.0"
service_host = "0.0.0.0"
service_port = 18099
allowed_origins = ["https://portal.example.com"]
test_auth_bypass_enabled = false
sse_poll_interval_seconds = 0.5
sse_heartbeat_seconds = 15
sse_batch_size = 200

[knowledge_core]
base_url = "http://knowledge-core:18090"
audience = "kbot-knowledge-core-api"
timeout_seconds = 120

[agent_runtime]
base_url = "http://agent-runtime-api:18100"
audience = "kbot-agent-runtime-api"
timeout_seconds = 120

[aiops]
base_url = "http://aiops-api:18110"
audience = "kbot-aiops-api"
timeout_seconds = 120

[model_embedding]
base_url = "http://model-embedding:18091"
audience = "kbot-model-embedding"
timeout_seconds = 120

[model_llm]
base_url = "http://model-llm:18092"
audience = "kbot-model-llm"
timeout_seconds = 120

[model_visual]
base_url = "http://model-visual:18093"
audience = "kbot-model-visual"
timeout_seconds = 120

[model_vlm]
base_url = "http://model-vlm:18094"
audience = "kbot-model-vlm"
timeout_seconds = 120

[integrations]
monitoring_max_webhook_bytes = 1048576
monitoring_requests_per_minute = 120
