[api]
service_name = "kbot-agent-runtime-api"
service_version = "4.0.0"
service_host = "0.0.0.0"
service_port = 18100

[worker]
service_name = "kbot-agent-runtime-worker"
worker_id = "agent-runtime-worker-01"
poll_interval_seconds = 1.0
lease_seconds = 120
memory_lease_seconds = 300
retention_poll_interval_seconds = 60
max_tasks_per_run = 16
max_parallel_tasks = 4
max_total_retries = 16
max_task_timeout_seconds = 600

[attachments]
# API 与 Worker 必须使用同一对象存储或共享持久卷。
local_storage_path = "/data/kbot/agent-runtime"

[ask_data_api]
api_endpoint = "http://aireport:10090/aireport/chat/with_selectai_api"
profiles_endpoint = "http://aireport:10090/aireport/admin/list_profiles"
api_key_env = "KBOT_MCP_DATA_API_KEY"
timeout = 120
max_rows = 1000
max_response_bytes = 10485760

[knowledge_core]
base_url = "http://knowledge-core-api:18090"
audience = "kbot-knowledge-core-api"
timeout_seconds = 120

[aiops]
base_url = "http://aiops-api:18110"
audience = "kbot-aiops-api"
timeout_seconds = 120

[llm]
base_url = "http://model-llm:18092"
audience = "kbot-model-llm"
timeout_seconds = 300

[embedding]
base_url = "http://model-embedding:18091"
audience = "kbot-model-embedding"
timeout_seconds = 300

[vlm]
base_url = "http://model-vlm:18094"
audience = "kbot-model-vlm"
timeout_seconds = 300
