# 复制到 configuration/base.toml；不要在此保存任何明文密钥。
[platform]
app_id = 1001
version = "4.0.0"

[log]
rotation = "100 MB"
retention = "10 days"
api_log_enabled = true

[security]
api_key_pepper_env = "KBOT_API_KEY_PEPPER"
internal_service_token_env = "KBOT_INTERNAL_SERVICE_TOKEN"
internal_jwt_secret_env = "KBOT_INTERNAL_JWT_SECRET"
internal_jwt_issuer = "kbot-platform"
internal_jwt_ttl_seconds = 60
internal_jwt_clock_skew_seconds = 5

# 用 scripts.generate_portal_api_key 生成明文 Key 与摘要。
# [[security.portal_api_keys]]
# key_id = "portal-primary"
# client_id = "km_portal"
# key_digest = "替换为 64 位十六进制摘要"
# enabled = true

# [[security.model_api_keys]]
# key_id = "model-client"
# client_id = "external_application"
# key_digest = "替换为 64 位十六进制摘要"
# enabled = true

[database.oracle]
password_env = "KBOT_ORACLE_PASSWORD"
port = 1521

[database.sqlalchemy]
echo = false
pool_size = 10
pool_timeout = 60
max_overflow = 20
pool_pre_ping = true
pool_use_lifo = true
pool_recycle = 1800

[vector]
# KC 向量列、模型注册校验和 Embedding 进程必须使用同一维度。
dimensions = 1536
