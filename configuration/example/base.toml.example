# core/config/base.toml
[app]
app_id = 1
service_name = "main-service"
service_version = "3.0.0"
service_host = "0.0.0.0"
service_port = 18099
host_ip = "127.0.0.1"
title = "KBOT"
description = "KBot API Service"
debug = true
file_storage = "/home/chris/kbot3/knowledge_base"
upload_workers = 10

[app.log]
level = "DEBUG"
dir = "/home/chris/kbot3/logs/"
rotation = "100 MB"
retention = "10 days"
api_log_enabled = true

[oracle]
username = "kbot"
password = "oracle"
host = "localhost"
port = 1521
service_name = "kbotdev"

[sqlalchemy]
echo = false
pool_size = 10
pool_timeout = 60
max_overflow = 20
pool_pre_ping = true
pool_use_lifo = true
pool_recycle = 1800

[embed]
service_name = "embedding-service"
service_version = "1.0.0"
service_host = "0.0.0.0"
service_port = 18091
dimensions = 1536
max_tokens = 1024
timeout = 300
max_retries = 3
cache_dir = "/home/chris/cached_models/"

[llm]
service_name = "llm-service"
service_version = "1.0.0"
service_host = "0.0.0.0"
service_port = 18092
max_tokens = 8192
temperature = 0.7
top_p = 1.0
top_k = 0
timeout = 300
frequency_penalty = 0.0
presence_penalty = 0.0

[reranker]
service_name = "reranker-service"
service_version = "1.0.0"
service_host = "0.0.0.0"
service_port = 18093
cache_dir = "/home/chris/cached_models/"
timeout = 300

[vlm]
service_name = "vlm-service"
service_version = "1.0.0"
service_host = "0.0.0.0"
service_port = 18094
timeout = 300

[parser]
service_name = "parser-service"
service_version = "1.0.0"
service_host = "0.0.0.0"
service_port = 18095
timeout = 600
local_artifacts_path = "/home/chris/models/docling_models"
queue_workers = 2
parser_parallel = 4
db_check_interval = 120

[jieba]
custom_dict_path = "/home/chris/kbot3/configuration/custom_dict.txt"
stop_words_path = "/home/chris/kbot3/configuration/stopwords.txt"

[prompt]
image2text = "SYSTEM/image2text"
summary = "SYSTEM/summary"