# core/config/base.toml
[app]
app_id = 1001
service_name = "kbot-main-service"
service_version = "3.2.0"
service_host = "0.0.0.0"
service_port = 18099
mcp_port = 18098
title = "KBOT"
description = "KBot API Service"
debug = true
file_storage = "/home/chris/kbot3/knowledge_base"
upload_workers = 10

[app.log]
level = "DEBUG"
dir = "/home/chris/kbot3/logs/"
rotation = "100 MB"
retention = "10 days"
api_log_enabled = true

[oracle]
username = "kbot"
password = "oracle"
host = "localhost"
port = 1521
service_name = "kbotdev"

[sqlalchemy]
echo = false
pool_size = 10
pool_timeout = 60
max_overflow = 20
pool_pre_ping = true
pool_use_lifo = true
pool_recycle = 1800

[embed]
service_name = "kbot-embedding-service"
service_version = "1.0.0"
service_host = "0.0.0.0"
service_port = 18091
dimensions = 1536
max_tokens = 1024
timeout = 300
max_retries = 3
cache_dir = "/home/chris/cached_models/"

[llm]
service_name = "kbot-llm-service"
service_version = "1.0.0"
service_host = "0.0.0.0"
service_port = 18092
max_tokens = 8192
temperature = 0.7
top_p = 1.0
top_k = 0
timeout = 300
frequency_penalty = 0.0
presence_penalty = 0.0

[reranker]
service_name = "kbot-reranker-service"
service_version = "1.0.0"
service_host = "0.0.0.0"
service_port = 18093
cache_dir = "/home/chris/cached_models/"
timeout = 300

[vlm]
service_name = "kbot-vlm-service"
service_version = "1.0.0"
service_host = "0.0.0.0"
service_port = 18094
timeout = 600

[parser]
service_name = "kbot-parser-service"
service_version = "1.0.0"
service_host = "0.0.0.0"
service_port = 18095
timeout = 600
local_artifacts_path = "/home/chris/models/docling_models"
queue_workers = 2
parser_parallel = 4
db_check_interval = 120

[executor]
service_name = "cube-sql-executor-service"
service_version = "1.0.0"
service_host = "0.0.0.0"
service_port = 18096

[dsocr]
enabled = false
service_name = "kbot-dsocr-service"
service_version = "1.0.0"
service_host = "0.0.0.0"
service_port = 18097
api_endpoint = "http://localhost:18097/v1/chat/completions"
timeout = 600
model_path = ""
crop_mode = true
max_tokens = 8192
temperature = 0.0

[prometheus]
base_url = "http://localhost:9090"
token = ""
timeout = 15
default_step = "60s"

[prompt]
image2text = "SYSTEM/image2text"
rewrite_question = "SYSTEM/rewrite_question"
refresh_summary = "SYSTEM/refresh_summary"
rag_final_render = "SYSTEM/rag_final_render"
user_profile = "SYSTEM/user_profile"
task_planner = "SYSTEM/task_planner"
intent_router = "SYSTEM/intent_router"
reasoning = "SYSTEM/reasoning"
generate_chart = "SYSTEM/generate_chart"
graph_vertex_fusion = "SYSTEM/graph_vertex_fusion"
graph_extractor = "SYSTEM/graph_extractor"
sql_gen = "SYSTEM/sql_gen"
sql_repair = "SYSTEM/sql_repair"
db_router = "SYSTEM/db_router"
ops_rewrite = "SYSTEM/ops_rewrite"
ops_diagnosis = "SYSTEM/ops_diagnosis"
ops_planner = "SYSTEM/ops_planner"

[slack]
agent_id = 164
api_timeout = 10

[ask_data_api]
api_endpoint = "http://132.145.80.161:10090/aireport/chat/with_selectai_api"
api_key = "airpt-8f4e8d5abeffbc5b793eb78d666b580f"
timeout = 120