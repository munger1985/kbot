import chardet
import re
from typing import List, Optional
from loguru import logger
import uuid
from .common import *
from .file_params import FileParams
from dao.entities.kbot_biz_txt_embedding import KbotBizTxtEmbedding
from core.dictionary import FileStatus, ChunkType
from utils.model_client import CallModel


class SimpleTextSplitter:
    """
    简洁高效的文本分割器
    专注于解决编码问题和合理切分
    """
    
    def __init__(self, 
                 chunk_size: int = 500,
                 chunk_overlap: int = 50,
                 min_chunk_size: int = 100,
                 max_chunk_size: int = 1000):
        self.chunk_size = chunk_size
        self.chunk_overlap = chunk_overlap
        self.min_chunk_size = min_chunk_size
        self.max_chunk_size = max_chunk_size
    
    async def detect_and_read_file(self, file_path: str) -> Optional[str]:
        """
        自动检测编码并读取文件，处理混合编码问题
        """
        # 首先读取二进制内容进行编码检测
        try:
            with open(file_path, 'rb') as f:
                raw_data = f.read()
            
            if not raw_data:
                return ""
                
            # 使用chardet检测编码
            detected = chardet.detect(raw_data)
            encoding = detected.get('encoding', 'utf-8')
            confidence = detected.get('confidence', 0)
            
            logger.info(f"检测到编码: {encoding}, 置信度: {confidence:.2f}")
            
            # 优先尝试检测到的编码
            if confidence > 0.6:
                try:
                    return raw_data.decode(encoding, errors='replace') # type: ignore
                except (UnicodeDecodeError, LookupError):
                    pass
            
            # 备选编码列表
            encodings = ['utf-8', 'gbk', 'gb18030', 'gb2312', 'latin1', 'iso-8859-1']
            
            for enc in encodings:
                if enc == encoding:
                    continue
                try:
                    return raw_data.decode(enc, errors='replace')
                except (UnicodeDecodeError, LookupError):
                    continue
            
            # 最后尝试忽略错误
            return raw_data.decode('utf-8', errors='ignore')
            
        except Exception as e:
            logger.error(f"读取文件失败: {e}")
            return None
    
    async def clean_text(self, text: str) -> str:
        """
        清理文本，处理常见乱码问题
        """
        if not text:
            return ""
        
        # 统一换行符
        text = text.replace('\r\n', '\n').replace('\r', '\n')
        
        # 清理过多的空白字符
        text = re.sub(r'[ \t]+', ' ', text)  # 多个空格/制表符合并为一个空格
        text = re.sub(r'\n{3,}', '\n\n', text)  # 多个空行合并为两个空行
        
        # 处理常见的乱码字符
        common_mojibake = {
            '锟斤拷': '', '烫烫烫': '', '屯屯屯': '',
            '�': '', '': '', '�': ''
        }
        
        for bad_char, replacement in common_mojibake.items():
            text = text.replace(bad_char, replacement)
        
        return text.strip()
    
    async def is_technical_content(self, text: str) -> bool:
        """
        判断是否为技术性内容（SQL、代码、日志等）
        """
        # 技术内容特征
        tech_indicators = [
            r'\b(SELECT|INSERT|UPDATE|DELETE|FROM|WHERE|CREATE|ALTER|DROP)\b',
            r'\b(error|warning|exception|debug|info|ERROR|WARNING)\b',
            r'(\d{4}-\d{2}-\d{2}\s+\d{2}:\d{2}:\d{2})',  # 时间戳
            r'(\.java|\.py|\.sql|\.xml|\.json)$',  # 文件扩展名
            r'(\[.*?\])',  # 方括号内容
            r'(\{.*?\})',  # 花括号内容
        ]
        
        sample = text[:1000]  # 检查前1000个字符
        tech_score = sum(1 for pattern in tech_indicators if re.search(pattern, sample, re.IGNORECASE))
        
        return tech_score >= 2
    
    async def smart_split(self, text: str) -> List[str]:
        """
        智能分割文本，根据内容类型选择最佳分割策略
        """
        if len(text) <= self.max_chunk_size:
            return [text] if len(text) >= self.min_chunk_size else []
        
        is_technical = self.is_technical_content(text)
        
        if is_technical:
            return await self._split_technical_text(text)
        else:
            return await self._split_natural_text(text)
    
    async def _split_technical_text(self, text: str) -> List[str]:
        """
        分割技术性文本（SQL、代码、日志等）
        """
        chunks = []
        
        # 首先尝试按空行分割
        sections = [section.strip() for section in text.split('\n\n') if section.strip()]
        
        current_chunk = ""
        current_length = 0
        
        for section in sections:
            section_length = len(section)
            
            # 如果章节本身就很大，先分割章节
            if section_length > self.max_chunk_size:
                if current_chunk:
                    chunks.append(current_chunk)
                    current_chunk = ""
                    current_length = 0
                
                # 对大数据块按行分割
                lines = section.split('\n')
                temp_chunk = ""
                temp_length = 0
                
                for line in lines:
                    line = line.strip()
                    if not line:
                        continue
                    
                    line_length = len(line)
                    
                    if temp_length + line_length > self.max_chunk_size and temp_chunk:
                        chunks.append(temp_chunk)
                        temp_chunk = line
                        temp_length = line_length
                    else:
                        if temp_chunk:
                            temp_chunk += "\n" + line
                            temp_length += line_length + 1
                        else:
                            temp_chunk = line
                            temp_length = line_length
                
                if temp_chunk:
                    chunks.append(temp_chunk)
            
            # 正常章节处理
            elif current_length + section_length > self.max_chunk_size and current_chunk:
                chunks.append(current_chunk)
                current_chunk = section
                current_length = section_length
            else:
                if current_chunk:
                    current_chunk += "\n\n" + section
                    current_length += section_length + 2
                else:
                    current_chunk = section
                    current_length = section_length
        
        if current_chunk:
            chunks.append(current_chunk)
        
        return chunks
    
    async def _split_natural_text(self, text: str) -> List[str]:
        """
        分割自然语言文本
        """
        chunks = []
        
        # 按段落分割
        paragraphs = [p.strip() for p in text.split('\n\n') if p.strip()]
        
        current_chunk = []
        current_length = 0
        
        for paragraph in paragraphs:
            para_length = len(paragraph)
            
            # 如果段落太长，按句子分割
            if para_length > self.max_chunk_size:
                if current_chunk:
                    chunks.append('\n\n'.join(current_chunk))
                    current_chunk = []
                    current_length = 0
                
                # 分割大段落
                sentences = await self._split_sentences(paragraph)
                temp_chunk = []
                temp_length = 0
                
                for sentence in sentences:
                    sent_length = len(sentence)
                    
                    if temp_length + sent_length > self.max_chunk_size and temp_chunk:
                        chunks.append(''.join(temp_chunk))
                        temp_chunk = [sentence]
                        temp_length = sent_length
                    else:
                        temp_chunk.append(sentence)
                        temp_length += sent_length
                
                if temp_chunk:
                    chunks.append(''.join(temp_chunk))
            
            # 正常段落处理
            elif current_length + para_length > self.max_chunk_size and current_chunk:
                chunks.append('\n\n'.join(current_chunk))
                current_chunk = [paragraph]
                current_length = para_length
            else:
                current_chunk.append(paragraph)
                current_length += para_length + 2  # +2 for \n\n
        
        if current_chunk:
            chunks.append('\n\n'.join(current_chunk))
        
        return chunks
    
    async def _split_sentences(self, text: str) -> List[str]:
        """
        简单的句子分割
        """
        # 中文句子分割
        sentences = re.split(r'([。！？；\.!?;])', text)
        result = []
        current = ""
        
        for i, part in enumerate(sentences):
            if re.match(r'[。！？；\.!?;]', part):
                if current:
                    current += part
                    result.append(current.strip())
                    current = ""
            else:
                if part.strip():
                    current += part
        
        if current.strip():
            result.append(current.strip())
        
        return result
    
    async def post_process_chunks(self, chunks: List[str]) -> List[str]:
        """
        后处理块，确保质量
        """
        result = []
        
        for chunk in chunks:
            chunk = chunk.strip()
            if not chunk:
                continue
            
            # 长度检查
            if len(chunk) < self.min_chunk_size:
                continue
            elif len(chunk) > self.max_chunk_size:
                # 强制分割
                parts = await self._force_split(chunk)
                result.extend(parts)
            else:
                result.append(chunk)
        
        # 合并过小的块
        return await self._merge_small_chunks(result)
    
    async def _force_split(self, text: str) -> List[str]:
        """强制按长度分割"""
        chunks = []
        while len(text) > self.max_chunk_size:
            # 尽量在段落边界分割
            split_pos = self.max_chunk_size
            
            # 向前找段落边界
            for i in range(min(200, len(text) - self.max_chunk_size)):
                pos = self.max_chunk_size - i
                if pos < self.min_chunk_size:
                    break
                if text[pos:pos+2] == '\n\n':
                    split_pos = pos + 2
                    break
            
            chunks.append(text[:split_pos].strip())
            text = text[split_pos:].strip()
        
        if text and len(text) >= self.min_chunk_size:
            chunks.append(text)
        
        return chunks
    
    async def _merge_small_chunks(self, chunks: List[str]) -> List[str]:
        """合并过小的块"""
        if len(chunks) <= 1:
            return chunks
        
        result = []
        current = chunks[0]
        
        for i in range(1, len(chunks)):
            if len(current) + len(chunks[i]) <= self.max_chunk_size:
                current += "\n\n" + chunks[i]
            else:
                result.append(current)
                current = chunks[i]
        
        result.append(current)
        return result


async def process_txt(file_params: FileParams) -> bool:
    """
    处理文本文件的主函数
    """
    if not await check_text_file(file_params):
        return False
    
    try:
        logger.info(f"开始处理文本文件: {file_params.file_path}")
        
        # 1. 读取文件
        splitter = SimpleTextSplitter()
        text = await splitter.detect_and_read_file(file_params.file_path)
        
        if text is None:
            msg = f"无法读取文件: {file_params.file_path}"
            logger.error(msg)
            await update_file_status(file_params.file_id, FileStatus.PARSE_FAILED, msg)
            return False
        
        if not text.strip():
            msg = f"文件内容为空: {file_params.file_path}"
            logger.info(msg)
            await update_file_status(file_params.file_id, FileStatus.PARSED, msg)
            return True
        
        # 2. 清理文本
        cleaned_text = await splitter.clean_text(text)
        logger.info(f"文本清理完成，原始长度: {len(text)}, 清理后: {len(cleaned_text)}")
        
        # 3. 配置分割参数
        chunk_size = int(file_params.parser.get("chunk_size", 500))
        overlap = int(file_params.parser.get("chunk_overlap", 50))
        
        # 更新分割器参数
        splitter.chunk_size = chunk_size
        splitter.chunk_overlap = overlap
        splitter.max_chunk_size = chunk_size * 2
        splitter.min_chunk_size = max(50, chunk_size // 5)
        
        # 4. 分割文本
        chunks = await splitter.smart_split(cleaned_text)
        chunks = await splitter.post_process_chunks(chunks)
        
        logger.info(f"成功分割 {len(chunks)} 个文本块")
        
        if not chunks:
            msg = f"未生成有效文本块: {file_params.file_path}"
            logger.warning(msg)
            await update_file_status(file_params.file_id, FileStatus.PARSED, msg)
            return True
        
        # 5. 去重
        unique_chunks = []
        seen = set()
        
        for chunk in chunks:
            # 使用前200字符的哈希去重
            chunk_hash = hash(chunk[:200].strip())
            if chunk_hash not in seen:
                seen.add(chunk_hash)
                unique_chunks.append(chunk)
        
        if len(unique_chunks) != len(chunks):
            logger.info(f"移除 {len(chunks) - len(unique_chunks)} 个重复块")
            chunks = unique_chunks
        
        # 6. 获取embedding
        if not file_params.txt_embed_model:
            msg = f"未配置embedding模型: {file_params.file_path}"
            logger.error(msg)
            await update_file_status(file_params.file_id, FileStatus.PARSE_FAILED, msg)
            return False
        
        logger.info("调用embedding服务...")
        response_data = await CallModel().call_embedding_model(file_params.txt_embed_model, chunks)
        
        if not response_data:
            msg = f"获取embedding向量失败: {file_params.file_path}"
            logger.error(msg)
            await update_file_status(file_params.file_id, FileStatus.PARSE_FAILED, msg)
            return False
        
        logger.info(f"成功获取 {len(response_data)} 个embedding向量")
        
        # 7. 保存结果
        embed_entities = []
        for i, (chunk, item) in enumerate(zip(chunks, response_data)):
            embed_entity = KbotBizTxtEmbedding(
                embed_id=str(uuid.uuid4()),
                chunk_doc=chunk,
                chunk_metadata={
                    "chunk_type": ChunkType.TEXT,
                    "chunk_num": i + 1,
                    "chunk_size": len(chunk),
                    "content_type": "technical" if splitter.is_technical_content(chunk) else "natural"
                },
                biz_metadata=file_params.biz_metadata,
                file_id=file_params.file_id,
                kb_id=file_params.kb_id,
                embedding=item.embedding,
                security_level=file_params.security_level,
                status=1
            )
            embed_entities.append(embed_entity)
        
        # 保存到向量数据库
        save_result = await save_embeddings(file_params, embed_entities)
        
        # 处理摘要（如果启用）
        summary_result = True
        if file_params.enable_summary:
            from .summary_parser import SummaryParser
            summary_result = await SummaryParser.process_summary(
                file_params=file_params, 
                embed_entities=embed_entities
            )
        
        return save_result and summary_result
        
    except Exception as e:
        msg = f"处理文本文件失败 {file_params.file_path}: {str(e)}"
        logger.exception(msg)
        await update_file_status(file_params.file_id, FileStatus.PARSE_FAILED, msg)
        return False