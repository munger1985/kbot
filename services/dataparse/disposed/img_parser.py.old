import uuid
from loguru import logger
from .file_params import FileParams
from dao.entities.kbot_biz_txt_embedding import KbotBizTxtEmbedding
from core.dictionary import FileStatus, ChunkType, SplitStrategy
from utils.model_client import CallModel
from .common import update_file_status, save_embeddings, check_image_file


async def process_img(file_params: FileParams) -> bool:
    """
    处理图片文件，调用 vlm 模型获取图片描述文本，并进行文本 embedding 处理后入库。
    
    参数:
        file_params: 文件参数对象
        
    返回:
        bool: 图片文件处理是否成功
    """

    if not await check_image_file(file_params):
        return False
    
    try:
        logger.debug(f"正在处理图片文件: {file_params.file_path}")

        # 1. 调用 vlm 模型获取图片描述文本
        logger.info(f"正在调用 vlm 模型获取图片描述文本")
        
        vlm_result = await CallModel().call_vlm_model_for_parsing_picture(file_params.img2txt_model, file_params.file_path) # type: ignore
        if vlm_result is None:
            msg = f"获取图片 {file_params.file_path} 的描述文本失败"
            logger.error(msg)
            await update_file_status(file_params.file_id, FileStatus.PARSE_FAILED, msg)
            return False
        else:
            logger.info(f"成功获取图片 {file_params.file_path} 的描述文本: {vlm_result}")
            chunks = [vlm_result]  # 将描述文本作为单个块进行处理
    
        # 3. 调用 embedding 微服务获取图片描述文本的向量
        logger.info(f"正在调用 embedding 微服务获取图片描述文本的向量")

        if file_params.txt_embed_model is None:
            msg = f"文件 {file_params.file_path} 未指定文本嵌入模型"
            logger.error(msg)
            # 更新文件状态为处理失败
            await update_file_status(file_params.file_id, FileStatus.PARSE_FAILED, msg)
            return False
        
        embed_data = await CallModel().call_embedding_model(file_params.txt_embed_model, chunks)
        if embed_data is None:
            msg = f"获取 {file_params.file_path} 图片描述文本的向量失败"
            logger.error(msg)
            await update_file_status(file_params.file_id, FileStatus.PARSE_FAILED, msg)
            return False
        else:
            logger.info(f"成功获取 {len(embed_data)} 个 embedding 向量")

            embeddings = [item.embedding for item in embed_data]
            embed_entities = []
            chunk_num = 1
            for chunk, embedding in zip(chunks, embeddings):
                embed_entity = KbotBizTxtEmbedding(
                    embed_id=str(uuid.uuid4()),
                    chunk_doc=chunk,
                    chunk_metadata={"chunk_type": ChunkType.IMAGE, "chunk_num": chunk_num},
                    biz_metadata=file_params.biz_metadata,
                    file_id=file_params.file_id,
                    kb_id=file_params.kb_id,
                    embedding=embedding,
                    security_level=file_params.security_level,
                    status=1
                )
                embed_entities.append(embed_entity)
                chunk_num += 1
            
            # 保存 embedding 向量到向量数据库
            return await save_embeddings(file_params, embed_entities)
            
    except Exception as e:
        msg = f"处理图片文件 {file_params.file_path} 时发生错误: {str(e)}"
        logger.exception(msg)  
        await update_file_status(file_params.file_id, FileStatus.PARSE_FAILED, msg)
        return False