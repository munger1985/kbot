{
  "schema_version": "DBA_SKILL_MANIFEST.v1",
  "skill_id": "oracle.maintenance.health",
  "version": "1.0.0",
  "database_types": ["ORACLE"],
  "version_range": {"minimum": "19", "maximum": "26"},
  "supported_intents": ["OBSERVE", "INSPECT", "DIAGNOSE"],
  "domains": ["MAINTENANCE", "DATA_INTEGRITY", "BACKUP_AND_RECOVERY"],
  "subjects": ["DATABASE_OVERVIEW"],
  "required_source_capabilities": [],
  "optional_source_capabilities": [],
  "required_target_capabilities": ["DB_READONLY", "dynamic_performance_views", "dba_catalog_views"],
  "required_privileges": ["V_$INSTANCE", "V_$DATABASE", "DBA_SCHEDULER_JOB_RUN_DETAILS", "DBA_OBJECTS", "V_$RMAN_BACKUP_JOB_DETAILS"],
  "required_entitlements": [],
  "input_schema": "oracle.maintenance.health.input.v1",
  "defaults": {"hours": 24, "days": 7, "limit": 50},
  "limits": {"max_rows": 700, "timeout_seconds": 30, "max_attempts": 2, "cost_units": 4},
  "tool_dag": [
    {"step_id": "identity", "tool_id": "db.instance.identity", "tool_version": "1.0.0", "depends_on": [], "input": {}},
    {"step_id": "scheduler", "tool_id": "db.scheduler.failed_jobs", "tool_version": "1.0.0", "depends_on": ["identity"], "input": {"hours": 24, "limit": 50}},
    {"step_id": "objects", "tool_id": "db.objects.invalid_summary", "tool_version": "1.0.0", "depends_on": ["identity"], "input": {}},
    {"step_id": "backup", "tool_id": "db.backup.recent_jobs", "tool_version": "1.0.0", "depends_on": ["identity"], "input": {"days": 7, "limit": 50}}
  ],
  "output_schema": "oracle.maintenance.health.output.v1",
  "measurement_semantics": "HISTORICAL_SAMPLES",
  "presentation_kind": "TABLE",
  "fallback_skills": ["oracle.instance.archive"],
  "manual_evidence_template": "oracle.maintenance.health.manual.v1",
  "sensitive_fields": ["owner", "job_name", "additional_info"],
  "redaction_rules": ["HASH_OWNER", "HASH_JOB_NAME", "MASK_ADDITIONAL_INFO"],
  "freshness": {"max_age_seconds": 900, "requires_observed_at": true}
}
