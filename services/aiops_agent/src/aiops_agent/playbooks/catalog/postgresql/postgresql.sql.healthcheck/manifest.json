{
  "schema_version": "DBA_PLAYBOOK_MANIFEST.v1",
  "playbook_id": "postgresql.sql.healthcheck",
  "version": "1.0.0",
  "database_types": ["POSTGRESQL"],
  "version_range": {"minimum": "12", "maximum": "20"},
  "supported_intents": ["OBSERVE", "DIAGNOSE"],
  "domains": ["SQL_PERFORMANCE"],
  "subjects": ["SQL_HEALTHCHECK", "SINGLE_SQL_PERFORMANCE", "POSTGRESQL_QUERY_ID"],
  "required_source_capabilities": [],
  "optional_source_capabilities": ["PROMETHEUS_QUERY"],
  "required_target_capabilities": ["DB_READONLY", "pg_stat_statements", "pg_stat_activity", "pg_stat_user_tables", "pg_stat_user_indexes", "pg_settings"],
  "required_privileges": ["pg_read_all_stats", "pg_read_all_settings"],
  "required_entitlements": [],
  "input_schema": "postgresql.sql.healthcheck.input.v1",
  "defaults": {"limit": 100},
  "limits": {"max_rows": 1000, "timeout_seconds": 180, "max_attempts": 2, "cost_units": 8},
  "tool_dag": [
    {"step_id": "identity", "tool_id": "db.instance.identity", "tool_version": "1.0.0", "depends_on": [], "input": {}},
    {"step_id": "statement", "tool_id": "db.postgresql.statement.details", "tool_version": "1.0.0", "depends_on": ["identity"], "input": {"limit": 20}},
    {"step_id": "objects", "tool_id": "db.sql.object_statistics", "tool_version": "1.0.0", "depends_on": ["statement"], "input": {"schema_name": "", "limit": 100}},
    {"step_id": "tables", "tool_id": "db.postgresql.table.statistics", "tool_version": "1.0.0", "depends_on": ["objects"], "input": {"limit": 100}},
    {"step_id": "indexes", "tool_id": "db.postgresql.index.statistics", "tool_version": "1.0.0", "depends_on": ["objects"], "input": {"limit": 100}},
    {"step_id": "activity", "tool_id": "db.session.current_sql", "tool_version": "1.0.0", "depends_on": ["statement"], "input": {"limit": 100}},
    {"step_id": "locks", "tool_id": "db.postgresql.lock.tree", "tool_version": "1.0.0", "depends_on": ["activity"], "input": {"limit": 100}},
    {"step_id": "parameters", "tool_id": "db.instance.parameters", "tool_version": "1.0.0", "depends_on": ["statement"], "input": {}}
  ],
  "output_schema": "postgresql.sql.healthcheck.output.v1",
  "measurement_semantics": "CUMULATIVE_SINCE_LOAD",
  "presentation_kind": "TABLE_AND_CHART",
  "fallback_playbooks": ["postgresql.sql.top_current"],
  "manual_evidence_template": "postgresql.sql.healthcheck.manual.v1",
  "sensitive_fields": ["normalized_statement", "query_text"],
  "redaction_rules": ["SQL_LITERAL_REDACTION"],
  "freshness": {"max_age_seconds": 120, "requires_observed_at": true}
}
