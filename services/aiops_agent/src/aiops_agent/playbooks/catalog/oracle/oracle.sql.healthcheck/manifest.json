{
  "schema_version": "DBA_PLAYBOOK_MANIFEST.v1",
  "playbook_id": "oracle.sql.healthcheck",
  "version": "1.0.0",
  "database_types": ["ORACLE"],
  "version_range": {"minimum": "19", "maximum": "26"},
  "supported_intents": ["OBSERVE", "DIAGNOSE"],
  "domains": ["SQL_PERFORMANCE"],
  "subjects": ["SQL_HEALTHCHECK", "SINGLE_SQL_PERFORMANCE"],
  "required_source_capabilities": [],
  "optional_source_capabilities": ["PROMETHEUS_QUERY"],
  "required_target_capabilities": ["DB_READONLY", "dynamic_performance_views", "dba_catalog_views"],
  "required_privileges": [
    "V_$INSTANCE",
    "V_$DATABASE",
    "GV_$SQL",
    "V_$SQL",
    "V_$SQL_PLAN",
    "V_$SQL_PLAN_STATISTICS_ALL",
    "GV_$SQL_PLAN",
    "DBA_TABLES",
    "DBA_TAB_STATISTICS",
    "GV_$SQL_PLAN_MONITOR",
    "GV_$SQL_MONITOR"
  ],
  "required_entitlements": [],
  "input_schema": "oracle.sql.healthcheck.input.v1",
  "defaults": {"limit": 50},
  "limits": {"max_rows": 500, "timeout_seconds": 240, "max_attempts": 2, "cost_units": 6},
  "tool_dag": [
    {"step_id": "identity", "tool_id": "db.instance.identity", "tool_version": "1.0.0", "depends_on": [], "input": {}},
    {"step_id": "cursor_details", "tool_id": "db.sql.cursor_details", "tool_version": "1.0.0", "depends_on": ["identity"], "input": {"limit": 50}},
    {"step_id": "display_cursor", "tool_id": "db.sql.display_cursor", "tool_version": "1.0.0", "depends_on": ["cursor_details"], "input": {}},
    {"step_id": "object_statistics", "tool_id": "db.sql.object_statistics", "tool_version": "1.0.0", "depends_on": ["display_cursor"], "input": {}},
    {"step_id": "plan_monitor", "tool_id": "db.sql.plan_monitor", "tool_version": "1.0.0", "depends_on": ["object_statistics"], "input": {"limit": 200}},
    {"step_id": "sql_monitor_report", "tool_id": "db.oracle.sql_monitor.report", "tool_version": "1.0.0", "depends_on": ["plan_monitor"], "input": {}}
  ],
  "output_schema": "oracle.sql.healthcheck.output.v1",
  "measurement_semantics": "CURRENT_ACTIVITY",
  "presentation_kind": "TABLE_AND_CHART",
  "fallback_playbooks": [],
  "manual_evidence_template": "oracle.sql.healthcheck.manual.v1",
  "sensitive_fields": [],
