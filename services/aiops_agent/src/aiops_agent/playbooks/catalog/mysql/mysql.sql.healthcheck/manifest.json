{
  "schema_version": "DBA_PLAYBOOK_MANIFEST.v1",
  "playbook_id": "mysql.sql.healthcheck",
  "version": "1.0.0",
  "database_types": ["MYSQL"],
  "version_range": {"minimum": "8", "maximum": "10"},
  "supported_intents": ["OBSERVE", "DIAGNOSE"],
  "domains": ["SQL_PERFORMANCE"],
  "subjects": ["SQL_HEALTHCHECK", "SINGLE_SQL_PERFORMANCE", "MYSQL_DIGEST"],
  "required_source_capabilities": [],
  "optional_source_capabilities": ["PROMETHEUS_QUERY"],
  "required_target_capabilities": ["DB_READONLY", "data_lock_waits", "information_schema", "performance_schema", "statement_digest", "statement_history"],
  "required_privileges": ["PROCESS"],
  "required_entitlements": [],
  "input_schema": "mysql.sql.healthcheck.input.v1",
  "defaults": {"limit": 50},
  "limits": {"max_rows": 500, "timeout_seconds": 180, "max_attempts": 2, "cost_units": 8},
  "tool_dag": [
    {"step_id": "identity", "tool_id": "db.instance.identity", "tool_version": "1.0.0", "depends_on": [], "input": {}},
    {"step_id": "digest", "tool_id": "db.sql.cursor_details", "tool_version": "1.0.0", "depends_on": ["identity"], "input": {"limit": 50}},
    {"step_id": "recent", "tool_id": "db.mysql.statement.history", "tool_version": "1.0.0", "depends_on": ["digest"], "input": {"limit": 100}},
    {"step_id": "objects", "tool_id": "db.sql.object_statistics", "tool_version": "1.0.0", "depends_on": ["digest"], "input": {"schema_name": "", "limit": 100}},
    {"step_id": "tables", "tool_id": "db.table.statistics", "tool_version": "1.0.0", "depends_on": ["objects"], "input": {"schema_name": "", "limit": 100}},
    {"step_id": "indexes", "tool_id": "db.index.health", "tool_version": "1.0.0", "depends_on": ["objects"], "input": {"limit": 100}},
    {"step_id": "statistics", "tool_id": "db.mysql.statistics.health", "tool_version": "1.0.0", "depends_on": ["tables"], "input": {"limit": 100}},
    {"step_id": "locks", "tool_id": "db.mysql.lock.current", "tool_version": "1.0.0", "depends_on": ["digest"], "input": {"limit": 100}},
    {"step_id": "parameters", "tool_id": "db.instance.parameters", "tool_version": "1.0.0", "depends_on": ["digest"], "input": {}}
  ],
  "output_schema": "mysql.sql.healthcheck.output.v1",
  "measurement_semantics": "CUMULATIVE_SINCE_LOAD",
  "presentation_kind": "TABLE_AND_CHART",
  "fallback_playbooks": [],
  "manual_evidence_template": "mysql.sql.healthcheck.manual.v1",
  "sensitive_fields": ["digest_text"],
  "redaction_rules": ["SQL_LITERAL_REDACTION"],
  "freshness": {"max_age_seconds": 120, "requires_observed_at": true}
}
