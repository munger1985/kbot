{
  "version": "exadata-status-v1",
  "groups": [
    {
      "metric_codes": ["oracle_exadata.Response.MSStatus"],
      "status": {
        "category": "AVAILABILITY", "display_name": "管理服务器响应状态",
        "values": {"RUNNING": {"label": "运行中", "tone": "success"}, "DOWN": {"label": "已停止", "tone": "danger"}, "UNKNOWN": {"label": "未知", "tone": "unknown"}},
        "provenance": "Oracle XA24.1.1 oracle_exadata_response.pl lines 145-147,195-204: running maps RUNNING, other service states DOWN; unreachable management status UNKNOWN. This does not prove cell service health."
      }
    },
    {
      "metric_codes": ["oracle_exadata.Response.MgmtNetworkPingStatus"],
      "status": {
        "category": "AVAILABILITY", "display_name": "管理网络 Ping 状态",
        "values": {"SUCCESS": {"label": "可达", "tone": "success"}, "FAILED": {"label": "不可达", "tone": "danger"}},
        "provenance": "Oracle XA24.1.1 oracle_exadata_response.pl lines 147,204 emits FAILED/SUCCESS. Management network reachability is not whole device availability."
      }
    },
    {
      "metric_codes": ["oracle_exadata.Response.Status"],
      "status": {
        "category": "AVAILABILITY", "display_name": "Cell 综合响应状态",
        "values": {"1": {"label": "可响应", "tone": "success"}, "0": {"label": "不可响应", "tone": "danger"}},
        "provenance": "Oracle XA24.1.1 oracle_exadata_response.pl lines 147,195-204 emits 1 for running management server and 0 for down or unreachable. Management response only, not entire cell hardware or storage health; STRING tokens kept exact."
      }
    },
    {
      "metric_codes": [
        "host.OEMTarget.status"
      ],
      "status": {
        "category": "AVAILABILITY",
        "display_name": "DB Server OEM 可用性",
        "values": {
          "UP": {
            "label": "可用",
            "tone": "success"
          }
        },
        "provenance": "OEM native GET /em/api/targets/{confirmed-guid} status, verified UP on 2026-11-12. Current status observation, not retained Response data or physical hardware health. Unknown tokens remain unknown."
      }
    },
    {
      "metric_codes": ["oracle_si_pdu.PduHttpResponse.Status"],
      "status": {
        "category": "AVAILABILITY", "display_name": "PDU HTTP 响应状态",
        "values": {"1": {"label": "可达", "tone": "success"}, "0": {"label": "不可达", "tone": "danger"}},
        "provenance": "Oracle oracle.sysman.si.agent.plugin_24.1.1.0.0 metadata/pdu_hw/pdu_metrics.xmlp PduHttpResponse: Value of 1 if the HTTP is responding, otherwise 0. Read-only verified 2026-11-12. HTTP responding is not power distribution health."
      }
    },
    {
      "metric_codes": ["oracle_si_netswitch.AccessPointResponse.statusMsg", "oracle_si_server_map.AccessPointResponse.statusMsg"],
      "status": {
        "category": "AVAILABILITY", "display_name": "管理访问点可达性",
        "values": {"UP": {"label": "可达", "tone": "success"}},
        "provenance": "OEM export 2026-11-10: switch 12 UP, server map 6 UP; keyed by ap_guid. UP only establishes that management access point, not device-wide or OS availability."
      }
    },
    {
      "metric_codes": ["oracle_si_server_map.SystemStatus.HealthStatus"],
      "status": {
        "category": "AVAILABILITY", "display_name": "服务器硬件健康状态",
        "values": {"OK": {"label": "正常", "tone": "success"}},
        "provenance": "OEM export 2026-11-10 SystemStatus/HealthStatus: two OK samples. Hardware health is not OS or database availability."
      }
    },
    {
      "metric_codes": ["oracle_si_server_map.SystemStatus.PowerStatus"],
      "status": {
        "category": "ADMINISTRATIVE", "display_name": "服务器电源状态",
        "values": {"On": {"label": "已开机", "tone": "neutral"}},
        "provenance": "OEM export 2026-11-10 SystemStatus/PowerStatus: two On samples. Powered on does not establish OS availability; other tokens unverified."
      }
    },
    {
      "metric_codes": ["oracle_si_server_map.SystemStatus.OSStatus"],
      "status": {
        "category": "AVAILABILITY", "display_name": "服务器操作系统状态", "values": {},
