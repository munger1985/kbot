{
  "catalog_version": "baseline.v1",
  "metrics": [
    {
      "metric_code": "db.availability",
      "semantic_version": "1.0.0",
      "name": "数据库可用性",
      "description": "由监控源确认的数据库目标可用状态。",
      "unit": "state",
      "value_kind": "STATE",
      "expected_dimensions": [],
      "supported_db_types": ["ORACLE", "MYSQL"],
      "allowed_aggregations": ["LAST"],
      "default_window_seconds": 3600,
      "min_step_seconds": 60,
      "max_points": 120,
      "max_series": 8,
      "providers": {
        "PROMETHEUS": {
          "template_id": "prom.db.up",
          "template_version": "1",
          "query_template": "up{instance=\"${external_target}\"}",
          "required_labels": ["instance"]
        },
        "ZABBIX": {
          "template_id": "zabbix.db.ping",
          "template_version": "1",
          "exact_item_key": "kbot.db.ping"
        },
        "OEM": {
          "template_id": "oem.db.status",
          "template_version": "1",
          "target_type": "oracle_database",
          "metric_name": "Status"
        }
      }
    },
    {
      "metric_code": "db.cpu.utilization",
      "semantic_version": "1.0.0",
      "name": "CPU 使用率",
      "description": "数据库目标或数据库实例进程的 CPU 使用百分比。",
      "unit": "percent",
      "value_kind": "GAUGE",
      "expected_dimensions": [],
      "supported_db_types": ["ORACLE", "MYSQL"],
      "allowed_aggregations": ["AVG", "MAX", "LAST"],
      "default_window_seconds": 3600,
      "min_step_seconds": 60,
      "max_points": 120,
      "max_series": 16,
      "providers": {
        "PROMETHEUS": {
          "template_id": "prom.db.cpu",
          "template_version": "1",
          "query_template": "kbot_db_cpu_utilization_percent{instance=\"${external_target}\"}",
          "required_labels": ["instance"]
        },
        "ZABBIX": {
          "template_id": "zabbix.db.cpu",
          "template_version": "1",
          "exact_item_key": "kbot.db.cpu.utilization"
        },
        "OEM": {
          "template_id": "oem.db.cpu",
          "template_version": "1",
          "target_type": "oracle_database",
          "metric_name": "CPUUtilization"
        }
      }
    },
