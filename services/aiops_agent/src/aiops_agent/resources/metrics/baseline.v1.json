    {
      "metric_code": "db.error.rate",
      "semantic_version": "1.0.0",
      "name": "错误率",
      "description": "监控源观测到的数据库错误事件速率。",
      "unit": "errors_per_second",
      "value_kind": "GAUGE",
      "expected_dimensions": [],
      "supported_db_types": ["ORACLE", "MYSQL"],
      "allowed_aggregations": ["AVG", "MAX", "LAST"],
      "default_window_seconds": 3600,
      "min_step_seconds": 60,
      "max_points": 120,
      "max_series": 16,
      "providers": {
        "PROMETHEUS": {
          "template_id": "prom.db.errors",
          "template_version": "1",
          "query_template": "rate(kbot_db_errors_total{instance=\"${external_target}\"}[5m])",
          "required_labels": ["instance"]
        },
        "ZABBIX": {
          "template_id": "zabbix.db.errors",
          "template_version": "1",
