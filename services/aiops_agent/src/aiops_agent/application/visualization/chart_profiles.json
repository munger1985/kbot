{
  "schema_version": "AIOPS_CHART_PROFILE_CATALOG.v1",
  "profiles": [
    {
      "profile_id": "inspection.weekly",
      "default_window_seconds": 604800,
      "max_charts": 4,
      "slots": [
        {
          "slot_id": "cpu",
          "title": "CPU 使用率趋势",
          "candidate_metric_codes": [
            "db.cpu.utilization",
            "host.cpu.utilization"
          ]
        },
        {
          "slot_id": "connection_utilization",
          "title": "连接使用率趋势",
          "candidate_metric_codes": [
            "db.connection.utilization"
          ]
        },
        {
          "slot_id": "active_connections",
          "title": "活跃连接数趋势",
          "candidate_metric_codes": [
            "db.connection.active"
          ]
        },
        {
          "slot_id": "used_space",
          "title": "表空间使用量趋势",
          "candidate_metric_codes": [
            "db.storage.used_bytes",
            "postgresql.database.size_bytes",
            "db.storage.utilization"
          ],
          "metric_titles": {
            "postgresql.database.size_bytes": "PostgreSQL 数据库逻辑容量趋势"
          }
        }
      ]
    }
  ]
}
