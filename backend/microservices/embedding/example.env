# 嵌入服务配置示例
# 复制此文件到.env并根据需要修改

# 服务配置
EMBEDDING_HOST=0.0.0.0
EMBEDDING_PORT=8000
EMBEDDING_WORKERS=1
EMBEDDING_LOG_LEVEL=info

# 模型池配置
EMBEDDING_MAX_IDLE_TIME=3600  # 模型最大空闲时间（秒）

# 批处理配置
EMBEDDING_MAX_BATCH_SIZE=64   # 最大批处理大小
EMBEDDING_MAX_WAIT_TIME=0.1   # 最大等待时间（秒）

# 健康检查配置
EMBEDDING_HEALTH_CHECK_INTERVAL=300  # 健康检查间隔（秒）

# 模型配置示例
# 可以通过环境变量为每个模型配置参数
# 格式为: EMBEDDING_MODEL_<MODEL_ID>_<PARAM_NAME>=<VALUE>

# text2vec-base 模型配置
EMBEDDING_MODEL_TEXT2VEC_API_URL=https://api.example.com/embedding
EMBEDDING_MODEL_TEXT2VEC_API_KEY=your_api_key_here
EMBEDDING_MODEL_TEXT2VEC_DIMENSIONS=768
EMBEDDING_MODEL_TEXT2VEC_MAX_TOKENS=512
EMBEDDING_MODEL_TEXT2VEC_TIMEOUT=30

# BGE 模型配置
EMBEDDING_MODEL_BGE_API_URL=https://api.example.com/bge
EMBEDDING_MODEL_BGE_API_KEY=your_bge_api_key
EMBEDDING_MODEL_BGE_DIMENSIONS=1024
EMBEDDING_MODEL_BGE_MAX_TOKENS=512
EMBEDDING_MODEL_BGE_TIMEOUT=30

# M3E 模型配置
EMBEDDING_MODEL_M3E_API_URL=https://api.example.com/m3e
EMBEDDING_MODEL_M3E_API_KEY=your_m3e_api_key
EMBEDDING_MODEL_M3E_DIMENSIONS=512
EMBEDDING_MODEL_M3E_MAX_TOKENS=512
EMBEDDING_MODEL_M3E_TIMEOUT=30

# 自定义模型配置
EMBEDDING_MODEL_CUSTOM_API_URL=https://your-custom-api.com/embed
EMBEDDING_MODEL_CUSTOM_API_KEY=your_custom_api_key
EMBEDDING_MODEL_CUSTOM_DIMENSIONS=384
EMBEDDING_MODEL_CUSTOM_MAX_TOKENS=1024
EMBEDDING_MODEL_CUSTOM_TIMEOUT=60
EMBEDDING_MODEL_CUSTOM_HEADERS={"X-Custom-Header": "value"}